import 'dart:async';
import 'dart:typed_data';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';

const _native = _LandCamNative();

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(const LandCamApp());
}

class _LandCamNative {
  const _LandCamNative();

  static const MethodChannel methods = MethodChannel('landcam/native');
  static const EventChannel events = EventChannel('landcam/events');

  Future<T?> invoke<T>(String method, [Object? arguments]) {
    return methods.invokeMethod<T>(method, arguments);
  }

  Stream<Object?> get stream => events.receiveBroadcastStream();
}

enum ConnectionMethod { nfc, currentWifi, lastWifi }

enum CameraConnectionState {
  idle,
  scanningNfc,
  nfcDetected,
  connectingWifi,
  startingCamera,
  liveView,
  connected,
  capturing,
  error,
}

class LandCamApp extends StatefulWidget {
  const LandCamApp({super.key});

  @override
  State<LandCamApp> createState() => _LandCamAppState();
}

class _LandCamAppState extends State<LandCamApp> {
  ThemeMode _themeMode = ThemeMode.light;

  void _toggleTheme() {
    setState(() {
      _themeMode = _themeMode == ThemeMode.light
          ? ThemeMode.dark
          : ThemeMode.light;
    });
  }

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'LANDCAM',
      themeMode: _themeMode,
      theme: _theme(Brightness.light),
      darkTheme: _theme(Brightness.dark),
      home: LandCamHome(
        themeMode: _themeMode,
        onToggleTheme: _toggleTheme,
      ),
    );
  }

  ThemeData _theme(Brightness brightness) {
    final dark = brightness == Brightness.dark;
    const accentLight = Color(0xFF6F8F00);
    const accentDark = Color(0xFFC8ED4C);
    final accent = dark ? accentDark : accentLight;
    final bg = dark ? const Color(0xFF080A09) : const Color(0xFFF1F3ED);
    final surface = dark ? const Color(0xFF111512) : Colors.white;
    final text = dark ? const Color(0xFFF1F4EC) : const Color(0xFF131713);
    final muted = dark ? const Color(0xFF929B91) : const Color(0xFF70786F);

    return ThemeData(
      brightness: brightness,
      useMaterial3: true,
      scaffoldBackgroundColor: bg,
      colorScheme: (dark ? ColorScheme.dark : ColorScheme.light)(
        primary: accent,
        secondary: accent,
        surface: surface,
        onSurface: text,
        onPrimary: dark ? Colors.black : Colors.white,
        error: dark ? const Color(0xFFFF716F) : const Color(0xFFC74C4C),
      ),
      fontFamily: 'monospace',
      dividerColor: dark ? const Color(0x252C2924) : const Color(0x1A30372F),
      textTheme: TextTheme(
        bodyMedium: TextStyle(color: text),
        bodySmall: TextStyle(color: muted),
      ),
    );
  }
}

class LandCamHome extends StatefulWidget {
  const LandCamHome({
    super.key,
    required this.themeMode,
    required this.onToggleTheme,
  });

  final ThemeMode themeMode;
  final VoidCallback onToggleTheme;

  @override
  State<LandCamHome> createState() => _LandCamHomeState();
}

class _LandCamHomeState extends State<LandCamHome>
    with WidgetsBindingObserver {
  StreamSubscription<Object?>? _events;

  CameraConnectionState _state = CameraConnectionState.idle;
  ConnectionMethod _method = ConnectionMethod.nfc;

  Uint8List? _liveFrame;
  String _cameraSsid = '';
  String _cameraModel = 'SONY CAMERA';
  String _transportMessage = 'READY';
  String? _error;

  bool _cameraReady = false;
  bool _captureBusy = false;
  bool _nfcSheetOpen = false;
  bool _quadMode = false;
  bool _grayscale = false;

  int _captureCount = 0;
  DateTime? _lastCapture;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _events = _native.stream.listen(
      _handleNativeEvent,
      onError: (Object error, StackTrace stack) {
        if (!mounted) return;
        setState(() {
          _state = CameraConnectionState.error;
          _cameraReady = false;
          _error = '$error';
          _transportMessage = 'NATIVE TRANSPORT ERROR';
        });
      },
    );
    unawaited(_initialize());
    unawaited(_setPortrait());
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _events?.cancel();
    unawaited(_native.invoke<void>('stopNfc'));
    super.dispose();
  }

  Future<void> _initialize() async {
    try {
      await _native.invoke<void>('initialize');
    } catch (error) {
      if (!mounted) return;
      setState(() {
        _state = CameraConnectionState.error;
        _error = '$error';
        _transportMessage = 'NATIVE BRIDGE ERROR';
      });
    }
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.resumed) {
      unawaited(SystemChrome.setEnabledSystemUIMode(SystemUiMode.immersiveSticky));
    }
  }

  Future<void> _setPortrait() async {
    await SystemChrome.setPreferredOrientations(const [
      DeviceOrientation.portraitUp,
    ]);
    await SystemChrome.setEnabledSystemUIMode(SystemUiMode.immersiveSticky);
  }

  Future<void> _setLandscape() async {
    await SystemChrome.setPreferredOrientations(const [
      DeviceOrientation.landscapeLeft,
      DeviceOrientation.landscapeRight,
    ]);
    await SystemChrome.setEnabledSystemUIMode(SystemUiMode.immersiveSticky);
  }

  void _toggleOrientation() {
    final orientation = MediaQuery.orientationOf(context);
    unawaited(
      orientation == Orientation.portrait ? _setLandscape() : _setPortrait(),
    );
  }

  bool get _connected => _state == CameraConnectionState.connected;

  bool get _busy => switch (_state) {
        CameraConnectionState.scanningNfc ||
        CameraConnectionState.nfcDetected ||
        CameraConnectionState.connectingWifi ||
        CameraConnectionState.startingCamera ||
        CameraConnectionState.capturing => true,
        _ => _captureBusy,
      };

  void _handleNativeEvent(Object? raw) {
    if (!mounted || raw is! Map) return;

    final type = raw['type']?.toString() ?? '';
    final data = raw['data'];

    switch (type) {
      case 'ready':
        return;

      case 'nfcStarted':
        setState(() {
          _state = CameraConnectionState.scanningNfc;
          _cameraReady = false;
          _transportMessage = 'HOLD PHONE TO CAMERA';
          _error = null;
        });
        return;

      case 'nfcDetected':
        final map = data is Map ? data : const <Object?, Object?>{};
        final ssid = map['ssid']?.toString() ?? '';
        setState(() {
          _state = CameraConnectionState.nfcDetected;
          _cameraSsid = ssid;
          _transportMessage = 'CAMERA CREDENTIALS RECEIVED';
          _error = null;
        });
        return;

      case 'wifiConnecting':
        setState(() {
          _state = CameraConnectionState.connectingWifi;
          _transportMessage = 'CONNECTING TO CAMERA WI-FI';
        });
        return;

      case 'wifiConnected':
        setState(() {
          _state = CameraConnectionState.startingCamera;
          _transportMessage = 'STARTING CAMERA';
        });
        return;

      case 'liveviewActive':
        setState(() {
          _state = CameraConnectionState.liveView;
          _transportMessage = 'WAITING FOR LIVE VIEW';
        });
        return;

      case 'firstLiveviewFrame':
        setState(() {
          _state = CameraConnectionState.connected;
          _cameraReady = true;
          _transportMessage = 'LIVE VIEW READY';
          _error = null;
        });
        HapticFeedback.mediumImpact();
        _closeNfcSheet();
        return;

      case 'liveviewFrame':
        final bytes = _bytesFromEvent(data is Map ? data['bytes'] : data);
        if (bytes == null || bytes.isEmpty) return;
        setState(() {
          _liveFrame = bytes;
          if (!_cameraReady) {
            _cameraReady = true;
            _state = CameraConnectionState.connected;
          }
        });
        return;

      case 'cameraInfo':
        final map = data is Map ? data : const <Object?, Object?>{};
        setState(() {
          _cameraModel = map['model']?.toString().isNotEmpty == true
              ? map['model'].toString()
              : _cameraModel;
          _cameraSsid = map['ssid']?.toString() ?? _cameraSsid;
        });
        return;

      case 'captureSaved':
        _captureBusy = false;
        final fileName = data?.toString() ?? '';
        setState(() {
          _captureCount++;
          _lastCapture = DateTime.now();
          _state = CameraConnectionState.connected;
          _cameraReady = true;
          _transportMessage = fileName.isEmpty
              ? 'PHOTO SAVED'
              : 'SAVED $fileName';
        });
        _showToast('PHOTO SAVED');
        return;

      case 'shutterAck':
        _captureBusy = false;
        setState(() {
          _state = CameraConnectionState.connected;
          _cameraReady = true;
          _transportMessage = 'SHUTTER OK';
        });
        return;

      case 'captureError':
        _captureBusy = false;
        _showToast(data?.toString() ?? 'CAPTURE FAILED', error: true);
        setState(() {
          _state = _cameraReady
              ? CameraConnectionState.connected
              : CameraConnectionState.error;
          _transportMessage = 'CAPTURE FAILED';
          _error = data?.toString();
        });
        return;

      case 'streamLost':
        setState(() {
          _state = CameraConnectionState.error;
          _cameraReady = false;
          _liveFrame = null;
          _transportMessage = 'LIVE VIEW LOST';
          _error = data?.toString();
        });
        _showToast('LIVE VIEW LOST', error: true);
        return;

      case 'cameraError':
      case 'networkUnavailable':
      case 'error':
        setState(() {
          _state = CameraConnectionState.error;
          _cameraReady = false;
          _transportMessage = data?.toString() ?? 'CAMERA ERROR';
          _error = data?.toString();
        });
        _showToast(data?.toString() ?? 'CAMERA ERROR', error: true);
        return;

      case 'disconnected':
        setState(() {
          _state = CameraConnectionState.idle;
          _cameraReady = false;
          _liveFrame = null;
          _cameraSsid = '';
          _transportMessage = 'READY';
          _error = null;
        });
        return;
    }
  }

  Uint8List? _bytesFromEvent(Object? value) {
    if (value is Uint8List) return value;
    if (value is List<int>) return Uint8List.fromList(value);
    if (value is List) {
      try {
        return Uint8List.fromList(value.whereType<num>().map((e) => e.toInt()).toList());
      } catch (_) {
        return null;
      }
    }
    return null;
  }

  Future<void> _openConnection() async {
    final selected = await showModalBottomSheet<ConnectionMethod>(
      context: context,
      backgroundColor: Colors.transparent,
      isScrollControlled: true,
      useSafeArea: true,
      showDragHandle: false,
      builder: (_) => _ConnectionSheet(
        state: _state,
        ssid: _cameraSsid,
        model: _cameraModel,
        error: _error,
        onDisconnect: _connected ? _disconnect : null,
      ),
    );

    if (!mounted || selected == null) return;

    _method = selected;
    _error = null;

    if (selected == ConnectionMethod.nfc) {
      await _startNfc();
    } else if (selected == ConnectionMethod.currentWifi) {
      await _useCurrentWifi();
    } else {
      await _reconnectLastWifi();
    }
  }

  Future<void> _startNfc() async {
    await _native.invoke<void>('stopNfc');

    if (mounted) {
      setState(() {
        _state = CameraConnectionState.scanningNfc;
        _cameraReady = false;
        _error = null;
        _transportMessage = 'HOLD PHONE TO CAMERA';
      });
    }

    await _showNfcSheet();

    try {
      await _native.invoke<void>('startNfc');
    } catch (error) {
      if (!mounted) return;
      setState(() {
        _state = CameraConnectionState.error;
        _error = '$error';
        _transportMessage = 'NFC FAILED';
      });
    }
  }

  Future<void> _showNfcSheet() async {
    _nfcSheetOpen = true;
    await showModalBottomSheet<void>(
      context: context,
      isDismissible: false,
      enableDrag: false,
      useSafeArea: true,
      backgroundColor: Colors.transparent,
      builder: (sheetContext) {
        return _NfcSheet(
          onCancel: () async {
            await _native.invoke<void>('stopNfc');
            if (sheetContext.mounted) Navigator.of(sheetContext).pop();
          },
        );
      },
    );
    _nfcSheetOpen = false;
  }

  void _closeNfcSheet() {
    if (!_nfcSheetOpen || !mounted) return;
    Navigator.of(context).pop();
  }

  Future<void> _reconnectLastWifi() async {
    setState(() {
      _state = CameraConnectionState.connectingWifi;
      _cameraReady = false;
      _transportMessage = 'RECONNECTING CAMERA WI-FI';
      _error = null;
    });

    try {
      await _native.invoke<void>('connectLastWifi');
    } catch (error) {
      if (!mounted) return;
      setState(() {
        _state = CameraConnectionState.error;
        _error = '$error';
        _transportMessage = 'WI-FI CONNECTION FAILED';
      });
    }
  }

  Future<void> _useCurrentWifi() async {
    setState(() {
      _state = CameraConnectionState.connectingWifi;
      _cameraReady = false;
      _transportMessage = 'USING CURRENT WI-FI';
      _error = null;
    });

    try {
      await _native.invoke<void>('connectCurrentWifi');
    } catch (error) {
      if (!mounted) return;
      setState(() {
        _state = CameraConnectionState.error;
        _error = '$error';
        _transportMessage = 'CURRENT WI-FI UNAVAILABLE';
      });
      _showToast('CURRENT WI-FI UNAVAILABLE', error: true);
    }
  }

  Future<void> _disconnect() async {
    try {
      await _native.invoke<void>('disconnect');
    } catch (_) {}

    if (!mounted) return;
    setState(() {
      _state = CameraConnectionState.idle;
      _cameraReady = false;
      _liveFrame = null;
      _cameraSsid = '';
      _transportMessage = 'READY';
      _error = null;
    });
    _showToast('CAMERA DISCONNECTED');
  }

  Future<void> _capture() async {
    if (!_cameraReady || !_connected || _captureBusy) {
      _showToast('CONNECT CAMERA BEFORE CAPTURE', error: true);
      return;
    }

    _captureBusy = true;
    setState(() {
      _state = CameraConnectionState.capturing;
      _transportMessage = 'CAPTURING';
    });
    HapticFeedback.heavyImpact();

    try {
      await _native.invoke<void>('capture');
    } catch (error) {
      _captureBusy = false;
      if (!mounted) return;
      setState(() {
        _state = CameraConnectionState.connected;
        _transportMessage = 'CAPTURE FAILED';
        _error = '$error';
      });
      _showToast('CAPTURE FAILED', error: true);
    }
  }

  Future<void> _autofocus() async {
    if (!_connected) {
      _showToast('CONNECT CAMERA FIRST', error: true);
      return;
    }
    try {
      await _native.invoke<void>('autofocus');
    } catch (error) {
      _showToast('AUTOFOCUS FAILED', error: true);
      if (mounted) {
        setState(() {
          _error = '$error';
        });
      }
    }
  }

  Future<void> _refreshLiveView() async {
    try {
      await _native.invoke<void>('refreshLiveview');
    } catch (error) {
      _showToast('LIVE VIEW REFRESH FAILED', error: true);
    }
  }

  Future<void> _toggleViewMode() async {
    setState(() => _quadMode = !_quadMode);
    try {
      final result = await _native.invoke<bool>('toggleViewMode');
      if (result != null && mounted) {
        setState(() => _quadMode = result);
      }
    } catch (_) {}
  }

  Future<void> _toggleGrayscale() async {
    final value = !_grayscale;
    setState(() => _grayscale = value);
    try {
      await _native.invoke<void>('setGrayscale', value);
    } catch (_) {}
  }

  void _showToast(String message, {bool error = false}) {
    if (!mounted) return;
    final color = error
        ? Theme.of(context).colorScheme.error
        : Theme.of(context).colorScheme.primary;
    final foreground = error
        ? Colors.white
        : Theme.of(context).colorScheme.onPrimary;
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        SnackBar(
          duration: const Duration(seconds: 2),
          behavior: SnackBarBehavior.floating,
          backgroundColor: color,
          content: Text(
            message,
            maxLines: 2,
            overflow: TextOverflow.ellipsis,
            style: TextStyle(
              color: foreground,
              fontSize: 10,
              fontWeight: FontWeight.w900,
              letterSpacing: .3,
            ),
          ),
        ),
      );
  }

  @override
  Widget build(BuildContext context) {
    final portrait = MediaQuery.orientationOf(context) == Orientation.portrait;
    final theme = Theme.of(context);
    final dark = theme.brightness == Brightness.dark;
    final accent = theme.colorScheme.primary;

    final preview = _PreviewSurface(
      frame: _liveFrame,
      grayscale: _grayscale,
      quadMode: _quadMode,
      accent: accent,
      connected: _cameraReady,
      onTap: _cameraReady ? () => unawaited(_autofocus()) : null,
    );

    final shutter = _ShutterButton(
      enabled: _cameraReady && !_captureBusy,
      capturing: _captureBusy,
      accent: accent,
      onPressed: () => unawaited(_capture()),
      size: portrait ? 102 : 94,
    );

    if (portrait) {
      return Scaffold(
        backgroundColor: Colors.black,
        body: SafeArea(
          bottom: false,
          child: Column(
            children: [
              _TopBar(
                dark: dark,
                accent: accent,
                connected: _cameraReady,
                busy: _busy,
                onConnection: _openConnection,
                onTheme: widget.onToggleTheme,
                onOrientation: _toggleOrientation,
              ),
              Expanded(
                child: Stack(
                  fit: StackFit.expand,
                  children: [
                    preview,
                    Positioned(
                      left: 14,
                      bottom: 18 + MediaQuery.viewPaddingOf(context).bottom,
                      child: _FloatingControl(
                        icon: Icons.center_focus_strong_rounded,
                        accent: accent,
                        onTap: () => unawaited(_autofocus()),
                        enabled: _connected,
                        label: 'FOCUS',
                      ),
                    ),
                    Positioned(
                      right: 14,
                      bottom: 18 + MediaQuery.viewPaddingOf(context).bottom,
                      child: Row(
                        children: [
                          _FloatingControl(
                            icon: _grayscale
                                ? Icons.contrast_rounded
                                : Icons.tonality_rounded,
                            accent: accent,
                            active: _grayscale,
                            onTap: () => unawaited(_toggleGrayscale()),
                            label: 'TONE',
                          ),
                          const SizedBox(width: 8),
                          _FloatingControl(
                            icon: _quadMode
                                ? Icons.view_quilt_rounded
                                : Icons.crop_free_rounded,
                            accent: accent,
                            active: _quadMode,
                            onTap: () => unawaited(_toggleViewMode()),
                            label: 'VIEW',
                          ),
                        ],
                      ),
                    ),
                    Align(
                      alignment: Alignment.bottomCenter,
                      child: Padding(
                        padding: EdgeInsets.only(
                          bottom: 18 + MediaQuery.viewPaddingOf(context).bottom,
                        ),
                        child: shutter,
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      );
    }

    return Scaffold(
      backgroundColor: Colors.black,
      body: SafeArea(
        child: Row(
          children: [
            _SideBar(
              dark: dark,
              accent: accent,
              connected: _cameraReady,
              busy: _busy,
              onConnection: _openConnection,
              onTheme: widget.onToggleTheme,
              onOrientation: _toggleOrientation,
            ),
            Expanded(
              child: preview,
            ),
            SizedBox(
              width: 122,
              child: Center(child: shutter),
            ),
          ],
        ),
      ),
    );
  }
}

class _TopBar extends StatelessWidget {
  const _TopBar({
    required this.dark,
    required this.accent,
    required this.connected,
    required this.busy,
    required this.onConnection,
    required this.onTheme,
    required this.onOrientation,
  });

  final bool dark;
  final Color accent;
  final bool connected;
  final bool busy;
  final VoidCallback onConnection;
  final VoidCallback onTheme;
  final VoidCallback onOrientation;

  @override
  Widget build(BuildContext context) {
    final bg = dark ? const Color(0xFF080A09) : const Color(0xFFF1F3ED);
    final fg = dark ? const Color(0xFFF1F4EC) : const Color(0xFF131713);
    return Container(
      height: 58,
      color: bg,
      padding: const EdgeInsets.symmetric(horizontal: 12),
      child: Row(
        children: [
          Container(
            width: 34,
            height: 34,
            decoration: BoxDecoration(
              color: accent,
              borderRadius: BorderRadius.circular(10),
            ),
            child: const Icon(
              Icons.camera_alt_rounded,
              size: 18,
              color: Colors.white,
            ),
          ),
          const SizedBox(width: 10),
          Text(
            'LANDCAM',
            style: TextStyle(
              color: fg,
              fontSize: 15,
              fontWeight: FontWeight.w900,
              letterSpacing: 2.0,
            ),
          ),
          const Spacer(),
          _HeaderButton(
            icon: Icons.wifi_rounded,
            accent: accent,
            connected: connected,
            busy: busy,
            onTap: onConnection,
            tooltip: 'Connection',
          ),
          const SizedBox(width: 6),
          _HeaderButton(
            icon: dark ? Icons.light_mode_rounded : Icons.dark_mode_rounded,
            accent: accent,
            onTap: onTheme,
            tooltip: 'Theme',
          ),
          const SizedBox(width: 6),
          _HeaderButton(
            icon: Icons.screen_rotation_alt_rounded,
            accent: accent,
            onTap: onOrientation,
            tooltip: 'Orientation',
          ),
        ],
      ),
    );
  }
}

class _SideBar extends StatelessWidget {
  const _SideBar({
    required this.dark,
    required this.accent,
    required this.connected,
    required this.busy,
    required this.onConnection,
    required this.onTheme,
    required this.onOrientation,
  });

  final bool dark;
  final Color accent;
  final bool connected;
  final bool busy;
  final VoidCallback onConnection;
  final VoidCallback onTheme;
  final VoidCallback onOrientation;

  @override
  Widget build(BuildContext context) {
    final bg = dark ? const Color(0xFF080A09) : const Color(0xFFF1F3ED);
    return Container(
      width: 62,
      color: bg,
      padding: const EdgeInsets.symmetric(vertical: 10),
      child: Column(
        children: [
          Container(
            width: 38,
            height: 38,
            decoration: BoxDecoration(
              color: accent,
              borderRadius: BorderRadius.circular(10),
            ),
            child: const Icon(
              Icons.camera_alt_rounded,
              size: 19,
              color: Colors.white,
            ),
          ),
          const Spacer(),
          _HeaderButton(
            icon: Icons.wifi_rounded,
            accent: accent,
            connected: connected,
            busy: busy,
            onTap: onConnection,
            tooltip: 'Connection',
            compact: true,
          ),
          const SizedBox(height: 8),
          _HeaderButton(
            icon: dark ? Icons.light_mode_rounded : Icons.dark_mode_rounded,
            accent: accent,
            onTap: onTheme,
            tooltip: 'Theme',
            compact: true,
          ),
          const SizedBox(height: 8),
          _HeaderButton(
            icon: Icons.screen_rotation_alt_rounded,
            accent: accent,
            onTap: onOrientation,
            tooltip: 'Orientation',
            compact: true,
          ),
        ],
      ),
    );
  }
}

class _HeaderButton extends StatelessWidget {
  const _HeaderButton({
    required this.icon,
    required this.accent,
    required this.onTap,
    required this.tooltip,
    this.connected = false,
    this.busy = false,
    this.compact = false,
  });

  final IconData icon;
  final Color accent;
  final VoidCallback onTap;
  final String tooltip;
  final bool connected;
  final bool busy;
  final bool compact;

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    return Tooltip(
      message: tooltip,
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap: onTap,
          borderRadius: BorderRadius.circular(compact ? 11 : 10),
          child: Ink(
            width: compact ? 40 : 42,
            height: compact ? 40 : 38,
            decoration: BoxDecoration(
              color: connected
                  ? accent.withValues(alpha: .10)
                  : theme.colorScheme.onSurface.withValues(alpha: .03),
              border: Border.all(
                color: connected
                    ? accent.withValues(alpha: .38)
                    : theme.dividerColor,
              ),
              borderRadius: BorderRadius.circular(compact ? 11 : 10),
            ),
            child: Stack(
              alignment: Alignment.center,
              children: [
                Icon(icon, size: compact ? 18 : 17, color: connected ? accent : theme.colorScheme.onSurface.withValues(alpha: .72)),
                if (busy)
                  Positioned(
                    right: 4,
                    top: 4,
                    child: SizedBox(
                      width: 7,
                      height: 7,
                      child: CircularProgressIndicator(
                        strokeWidth: 1.4,
                        color: accent,
                      ),
                    ),
                  ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class _PreviewSurface extends StatelessWidget {
  const _PreviewSurface({
    required this.frame,
    required this.grayscale,
    required this.quadMode,
    required this.accent,
    required this.connected,
    required this.onTap,
  });

  final Uint8List? frame;
  final bool grayscale;
  final bool quadMode;
  final Color accent;
  final bool connected;
  final VoidCallback? onTap;

  @override
  Widget build(BuildContext context) {
    Widget image;
    if (frame == null || frame!.isEmpty) {
      image = const ColoredBox(color: Colors.black);
    } else {
      image = Image.memory(
        frame!,
        fit: BoxFit.contain,
        gaplessPlayback: true,
        filterQuality: FilterQuality.medium,
      );
    }

    final content = Stack(
      fit: StackFit.expand,
      children: [
        ColoredBox(
          color: Colors.black,
          child: grayscale
              ? ColorFiltered(
                  colorFilter: const ColorFilter.matrix(<double>[
                    .2126, .7152, .0722, 0, 0,
                    .2126, .7152, .0722, 0, 0,
                    .2126, .7152, .0722, 0, 0,
                    0, 0, 0, 1, 0,
                  ]),
                  child: image,
                )
              : image,
        ),
        IgnorePointer(
          child: CustomPaint(
            painter: _PreviewPainter(
              color: Colors.white.withValues(alpha: frame == null ? .22 : .42),
              accent: accent,
              connected: connected,
              quadMode: quadMode,
            ),
          ),
        ),
      ],
    );

    if (onTap == null) return content;
    return GestureDetector(
      behavior: HitTestBehavior.opaque,
      onDoubleTap: onTap,
      child: content,
    );
  }
}

class _PreviewPainter extends CustomPainter {
  const _PreviewPainter({
    required this.color,
    required this.accent,
    required this.connected,
    required this.quadMode,
  });

  final Color color;
  final Color accent;
  final bool connected;
  final bool quadMode;

  @override
  void paint(Canvas canvas, Size size) {
    final p = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.0
      ..color = color;

    const inset = 13.0;
    const length = 20.0;

    void corner(double x, double y, double sx, double sy) {
      canvas.drawLine(Offset(x, y), Offset(x + sx * length, y), p);
      canvas.drawLine(Offset(x, y), Offset(x, y + sy * length), p);
    }

    corner(inset, inset, 1, 1);
    corner(size.width - inset, inset, -1, 1);
    corner(inset, size.height - inset, 1, -1);
    corner(size.width - inset, size.height - inset, -1, -1);

    final center = Offset(size.width / 2, size.height / 2);
    final reticle = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = connected ? 1.15 : .8
      ..color = connected ? accent.withValues(alpha: .75) : color.withValues(alpha: .38);

    canvas.drawCircle(center, quadMode ? 30 : 23, reticle);
    canvas.drawLine(
      Offset(center.dx - 34, center.dy),
      Offset(center.dx + 34, center.dy),
      reticle,
    );
    canvas.drawLine(
      Offset(center.dx, center.dy - 34),
      Offset(center.dx, center.dy + 34),
      reticle,
    );
    canvas.drawCircle(center, 2.2, Paint()..color = reticle.color);
  }

  @override
  bool shouldRepaint(covariant _PreviewPainter oldDelegate) =>
      oldDelegate.color != color ||
      oldDelegate.accent != accent ||
      oldDelegate.connected != connected ||
      oldDelegate.quadMode != quadMode;
}

class _ShutterButton extends StatelessWidget {
  const _ShutterButton({
    required this.enabled,
    required this.capturing,
    required this.accent,
    required this.onPressed,
    required this.size,
  });

  final bool enabled;
  final bool capturing;
  final Color accent;
  final VoidCallback onPressed;
  final double size;

  @override
  Widget build(BuildContext context) {
    final outer = size;
    final inner = size - 18;
    return Semantics(
      button: true,
      label: 'Camera shutter',
      enabled: enabled,
      child: GestureDetector(
        onTap: enabled ? onPressed : null,
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 120),
          width: outer,
          height: outer,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: Colors.black.withValues(alpha: .18),
            border: Border.all(
              color: enabled ? Colors.white.withValues(alpha: .9) : Colors.white.withValues(alpha: .25),
              width: 2,
            ),
            boxShadow: [
              BoxShadow(
                color: accent.withValues(alpha: enabled ? .16 : .04),
                blurRadius: 18,
              ),
            ],
          ),
          alignment: Alignment.center,
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 120),
            width: inner,
            height: inner,
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: enabled ? Colors.white : Colors.white.withValues(alpha: .34),
            ),
            alignment: Alignment.center,
            child: capturing
                ? SizedBox(
                    width: 22,
                    height: 22,
                    child: CircularProgressIndicator(
                      strokeWidth: 2.4,
                      color: accent,
                    ),
                  )
                : Container(
                    width: 13,
                    height: 13,
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      color: accent,
                    ),
                  ),
          ),
        ),
      ),
    );
  }
}

class _FloatingControl extends StatelessWidget {
  const _FloatingControl({
    required this.icon,
    required this.accent,
    required this.onTap,
    required this.label,
    this.enabled = true,
    this.active = false,
  });

  final IconData icon;
  final Color accent;
  final VoidCallback onTap;
  final String label;
  final bool enabled;
  final bool active;

  @override
  Widget build(BuildContext context) {
    return Tooltip(
      message: label,
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap: enabled ? onTap : null,
          borderRadius: BorderRadius.circular(12),
          child: Ink(
            width: 42,
            height: 42,
            decoration: BoxDecoration(
              color: Colors.black.withValues(alpha: .38),
              border: Border.all(
                color: active
                    ? accent.withValues(alpha: .85)
                    : Colors.white.withValues(alpha: enabled ? .34 : .12),
              ),
              borderRadius: BorderRadius.circular(12),
            ),
            child: Icon(
              icon,
              size: 18,
              color: active
                  ? accent
                  : Colors.white.withValues(alpha: enabled ? .9 : .30),
            ),
          ),
        ),
      ),
    );
  }
}

class _ConnectionSheet extends StatelessWidget {
  const _ConnectionSheet({
    required this.state,
    required this.ssid,
    required this.model,
    required this.error,
    required this.onDisconnect,
  });

  final CameraConnectionState state;
  final String ssid;
  final String model;
  final String? error;
  final VoidCallback? onDisconnect;

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final accent = theme.colorScheme.primary;
    final ready = state == CameraConnectionState.connected;
    final busy = switch (state) {
      CameraConnectionState.scanningNfc ||
      CameraConnectionState.nfcDetected ||
      CameraConnectionState.connectingWifi ||
      CameraConnectionState.startingCamera ||
      CameraConnectionState.capturing => true,
      _ => false,
    };

    return _SheetSurface(
      child: SingleChildScrollView(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            const _SheetHandle(),
            const SizedBox(height: 14),
            Row(
              children: [
                Container(
                  width: 44,
                  height: 44,
                  decoration: BoxDecoration(
                    color: accent.withValues(alpha: .08),
                    border: Border.all(color: accent.withValues(alpha: .25)),
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Icon(Icons.wifi_tethering_rounded, color: accent),
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'CAMERA CONNECTION',
                        style: TextStyle(
                          fontSize: 11,
                          fontWeight: FontWeight.w900,
                          letterSpacing: .7,
                        ),
                      ),
                      const SizedBox(height: 4),
                      Text(
                        ready
                            ? 'LIVE VIEW READY'
                            : busy
                                ? 'WORKING'
                                : state == CameraConnectionState.error
                                    ? 'CONNECTION ERROR'
                                    : 'READY TO CONNECT',
                        style: TextStyle(
                          color: ready || busy ? accent : theme.colorScheme.onSurface.withValues(alpha: .48),
                          fontSize: 7.5,
                          fontWeight: FontWeight.w900,
                          letterSpacing: .6,
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
            const SizedBox(height: 13),
            Container(
              padding: const EdgeInsets.all(11),
              decoration: BoxDecoration(
                color: theme.colorScheme.onSurface.withValues(alpha: .025),
                border: Border.all(color: theme.dividerColor),
                borderRadius: BorderRadius.circular(12),
              ),
              child: Column(
                children: [
                  _InfoLine(label: 'MODEL', value: model),
                  _InfoLine(label: 'WI-FI', value: ssid.isEmpty ? '--' : ssid),
                  _InfoLine(label: 'TRANSPORT', value: 'NFC + CAMERA WI-FI'),
                  _InfoLine(label: 'STATE', value: state.name.toUpperCase()),
                ],
              ),
            ),
            if (error != null && error!.isNotEmpty) ...[
              const SizedBox(height: 9),
              Text(
                error!,
                style: TextStyle(
                  color: theme.colorScheme.error,
                  fontSize: 8,
                  height: 1.45,
                ),
              ),
            ],
            const SizedBox(height: 12),
            _ConnectionAction(
              icon: Icons.contactless_rounded,
              title: 'PAIR WITH NFC',
              subtitle: 'READ SONY DIRECT- CREDENTIALS',
              accent: accent,
              onTap: () => Navigator.of(context).pop(ConnectionMethod.nfc),
            ),
            const SizedBox(height: 8),
            _ConnectionAction(
              icon: Icons.wifi_tethering_rounded,
              title: 'USE CURRENT WI-FI',
              subtitle: 'USE THE NETWORK CURRENTLY CONNECTED TO THIS PHONE',
              accent: accent,
              onTap: () => Navigator.of(context).pop(ConnectionMethod.currentWifi),
            ),
            const SizedBox(height: 8),
            _ConnectionAction(
              icon: Icons.restart_alt_rounded,
              title: 'RECONNECT LAST CAMERA',
              subtitle: 'USE THE LAST SAVED CAMERA WI-FI',
              accent: accent,
              onTap: () => Navigator.of(context).pop(ConnectionMethod.lastWifi),
            ),
            if (onDisconnect != null) ...[
              const SizedBox(height: 8),
              OutlinedButton.icon(
                onPressed: onDisconnect,
                style: OutlinedButton.styleFrom(
                  minimumSize: const Size.fromHeight(46),
                  foregroundColor: theme.colorScheme.error,
                  side: BorderSide(color: theme.colorScheme.error.withValues(alpha: .3)),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(11),
                  ),
                ),
                icon: const Icon(Icons.link_off_rounded, size: 17),
                label: const Text(
                  'DISCONNECT CAMERA',
                  style: TextStyle(
                    fontSize: 8,
                    fontWeight: FontWeight.w900,
                    letterSpacing: .7,
                  ),
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }
}

class _NfcSheet extends StatefulWidget {
  const _NfcSheet({required this.onCancel});

  final Future<void> Function() onCancel;

  @override
  State<_NfcSheet> createState() => _NfcSheetState();
}

class _NfcSheetState extends State<_NfcSheet> {
  Timer? _timer;
  int _tick = 0;

  @override
  void initState() {
    super.initState();
    _timer = Timer.periodic(const Duration(milliseconds: 750), (_) {
      if (!mounted) return;
      setState(() => _tick++);
    });
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final accent = theme.colorScheme.primary;
    final pulse = _tick.isEven;

    return _SheetSurface(
      child: SingleChildScrollView(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const _SheetHandle(),
            const SizedBox(height: 12),
            const Text(
              'NFC CAMERA PAIRING',
              style: TextStyle(
                fontSize: 12,
                fontWeight: FontWeight.w900,
                letterSpacing: .8,
              ),
            ),
            const SizedBox(height: 3),
            Text(
              'LANDCAM IS WAITING FOR THE SONY CAMERA',
              style: TextStyle(
                color: theme.colorScheme.onSurface.withValues(alpha: .38),
                fontSize: 7,
                fontWeight: FontWeight.w800,
                letterSpacing: .45,
              ),
            ),
            const SizedBox(height: 16),
            AnimatedContainer(
              duration: const Duration(milliseconds: 320),
              width: pulse ? 118 : 104,
              height: pulse ? 118 : 104,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: accent.withValues(alpha: .06),
                border: Border.all(
                  color: accent.withValues(alpha: pulse ? .72 : .34),
                  width: 2,
                ),
              ),
              alignment: Alignment.center,
              child: Container(
                width: 68,
                height: 68,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: accent.withValues(alpha: .13),
                  border: Border.all(color: accent.withValues(alpha: .4)),
                ),
                child: Icon(Icons.contactless_rounded, color: accent, size: 31),
              ),
            ),
            const SizedBox(height: 13),
            Text(
              'HOLD PHONE TO SONY N-MARK',
              style: TextStyle(
                color: accent,
                fontSize: 9,
                fontWeight: FontWeight.w900,
                letterSpacing: .8,
              ),
            ),
            const SizedBox(height: 5),
            Text(
              'LANDCAM handles the NFC payload directly and uses it to join the camera Wi-Fi.',
              textAlign: TextAlign.center,
              style: TextStyle(
                color: theme.colorScheme.onSurface.withValues(alpha: .38),
                fontSize: 8,
                height: 1.5,
              ),
            ),
            const SizedBox(height: 12),
            TextButton(
              onPressed: () => unawaited(widget.onCancel()),
              child: const Text(
                'CANCEL',
                style: TextStyle(
                  fontSize: 8,
                  fontWeight: FontWeight.w900,
                  letterSpacing: .8,
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

