---
const appName = "LANDCAM";
const appVersion = "UI PROTOTYPE 0.1";

const bands = [
  { key: "B", name: "BLUE", value: "0.214" },
  { key: "G", name: "GREEN", value: "0.462" },
  { key: "R", name: "RED", value: "0.183" },
  { key: "NIR", name: "NIR", value: "0.731" },
];

const captures = [
  {
    no: 1842,
    time: "08:42:31",
    lat: "-7.79561",
    lon: "110.36949",
    alt: "98.4 m",
    status: "SAVED",
  },
  {
    no: 1841,
    time: "08:42:30",
    lat: "-7.79558",
    lon: "110.36944",
    alt: "98.5 m",
    status: "SAVED",
  },
  {
    no: 1840,
    time: "08:42:29",
    lat: "-7.79552",
    lon: "110.36938",
    alt: "98.7 m",
    status: "SAVED",
  },
  {
    no: 1839,
    time: "08:42:28",
    lat: "-7.79547",
    lon: "110.36932",
    alt: "99.0 m",
    status: "SAVED",
  },
  {
    no: 1838,
    time: "08:42:27",
    lat: "-7.79541",
    lon: "110.36926",
    alt: "99.2 m",
    status: "SAVED",
  },
  {
    no: 1837,
    time: "08:42:26",
    lat: "-7.79535",
    lon: "110.36921",
    alt: "99.5 m",
    status: "SAVED",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <meta
      name="description"
      content="LandCam Multispectral Camera Controller UI Prototype"
    />
    <meta
      name="theme-color"
      content="#090b0a"
      id="themeColor"
    />
    <title>LANDCAM — Controller</title>

    <style>
      html {
        background: #090b0a;
      }
    </style>
  </head>

  <body>
    <div class="app" data-app>
      <!-- =========================================================
           HEADER
      ========================================================== -->
      <header class="topbar">
        <div class="topbar__brand">
          <span class="brand-mark" aria-hidden="true"></span>

          <div>
            <div class="brand-name">LANDCAM</div>
            <div class="brand-sub">MULTISPECTRAL CONTROLLER</div>
          </div>
        </div>

        <div class="topbar__center">
          <div class="system-chip">
            <span
              class="system-dot"
              id="systemDot"
            ></span>

            <span id="systemLabel">
              SYSTEM READY
            </span>
          </div>
        </div>

        <div class="topbar__right">
          <button
            class="device-trigger"
            id="topConnect"
            type="button"
            aria-label="Open device list"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            <span class="device-trigger__status"></span>

            <span class="device-trigger__copy">
              <small>DEVICE</small>
              <strong id="topDeviceName">LC-4 SPECTRA</strong>
            </span>

            <span class="device-trigger__chevron">⌄</span>
          </button>
        </div>
      </header>

      <!-- =========================================================
           MAIN
      ========================================================== -->
      <main class="main">

        <!-- =======================================================
             HOME
        ======================================================== -->
        <section
          class="screen is-active"
          id="screen-home"
          data-screen="home"
        >
          <div class="screen-head">
            <div>
              <div class="eyebrow">DEVICE OVERVIEW</div>
              <h1>Controller</h1>
              <p>
                Field acquisition console for LC-4 Spectra.
              </p>
            </div>

            <div class="screen-head__meta">
              <span>22 SEP 2026</span>
              <strong>FIELD 01</strong>
            </div>
          </div>

          <!-- DEVICE -->
          <article class="device-card">
            <div class="device-card__top">
              <div class="device-card__identity">
                <div class="micro-label">
                  SELECTED DEVICE
                </div>

                <div
                  class="device-name"
                  id="homeDeviceName"
                >
                  LC-4 SPECTRA
                </div>

                <div
                  class="device-id"
                  id="homeDeviceId"
                >
                  LANDCAM / DEMO-LC4-001
                </div>
              </div>

              <button
                class="status-pill status-pill--online"
                id="connectButton"
                type="button"
                aria-haspopup="dialog"
                aria-expanded="false"
              >
                <span class="status-pill__dot"></span>

                <span id="connectLabel">
                  CONNECTED
                </span>
              </button>
            </div>

            <div class="device-card__bottom">
              <div>
                <span class="micro-label">CAPTURE</span>
                <strong id="homeCaptureCount">
                  01,842
                </strong>
              </div>

              <div>
                <span class="micro-label">STORAGE</span>
                <strong>42.8 / 64 GB</strong>
              </div>

              <div>
                <span class="micro-label">FIRMWARE</span>
                <strong id="homeFirmware">
                  1.0.0
                </strong>
              </div>
            </div>
          </article>

          <!-- TELEMETRY -->
          <div class="section-label">
            <span>01 / TELEMETRY</span>
            <span class="section-line"></span>
            <span>LIVE</span>
          </div>

          <div class="telemetry-grid">
            <article class="telemetry-card">
              <span class="telemetry-card__label">
                GNSS
              </span>

              <strong class="telemetry-card__value value-ok">
                FIX
              </strong>

              <span class="telemetry-card__meta">
                12 SAT · ±0.03 M
              </span>
            </article>

            <article class="telemetry-card">
              <span class="telemetry-card__label">
                PPS
              </span>

              <strong class="telemetry-card__value value-ok">
                LOCKED
              </strong>

              <span class="telemetry-card__meta">
                TIME SYNC READY
              </span>
            </article>

            <article class="telemetry-card">
              <span class="telemetry-card__label">
                BATTERY
              </span>

              <strong
                class="telemetry-card__value"
                id="homeBattery"
              >
                87%
              </strong>

              <span class="telemetry-card__meta">
                EXTERNAL POWER
              </span>
            </article>

            <article class="telemetry-card">
              <span class="telemetry-card__label">
                TEMP
              </span>

              <strong class="telemetry-card__value">
                31.4°C
              </strong>

              <span class="telemetry-card__meta">
                NORMAL RANGE
              </span>
            </article>
          </div>

          <!-- CAMERA SUMMARY -->
          <div class="section-label">
            <span>02 / CAMERA</span>
            <span class="section-line"></span>
            <span>RGB + NIR</span>
          </div>

          <article class="camera-summary">
            <div class="camera-preview camera-preview--small">
              <div class="preview-grid"></div>
              <div class="preview-horizon"></div>

              <div class="preview-field">
                <div class="field-block field-block--a"></div>
                <div class="field-block field-block--b"></div>
                <div class="field-track"></div>
              </div>

              <div class="preview-crosshair">
                <span></span>
                <i></i>
              </div>

              <div class="preview-label">
                FRAME PREVIEW
              </div>

              <div class="preview-tag">
                RGB-NIR
              </div>
            </div>

            <div class="camera-summary__info">
              <div class="camera-summary__head">
                <div>
                  <span class="micro-label">
                    LAST CAPTURE
                  </span>

                  <strong>08:42:31</strong>
                </div>

                <span class="mini-badge">
                  SAVED
                </span>
              </div>

              <div class="camera-summary__stats">
                <div>
                  <span>BAND</span>
                  <strong>04</strong>
                </div>

                <div>
                  <span>ALT</span>
                  <strong>98.4 M</strong>
                </div>

                <div>
                  <span>GSD</span>
                  <strong>—</strong>
                </div>
              </div>

              <button
                class="wide-button wide-button--primary"
                data-go="camera"
                type="button"
              >
                <span>OPEN CAMERA</span>
                <span class="button-arrow">↗</span>
              </button>
            </div>
          </article>

          <!-- QUICK ACTION -->
          <div class="section-label">
            <span>03 / QUICK ACTION</span>
            <span class="section-line"></span>
            <span>FIELD</span>
          </div>

          <div class="quick-grid">
            <button
              class="quick-card quick-card--primary"
              data-action="capture"
              type="button"
            >
              <span class="quick-card__icon">+</span>

              <span class="quick-card__main">
                <strong>CAPTURE</strong>
                <small>TAKE FRAME</small>
              </span>

              <span class="quick-card__arrow">↗</span>
            </button>

            <button
              class="quick-card"
              data-go="mission"
              type="button"
            >
              <span class="quick-card__icon">◎</span>

              <span class="quick-card__main">
                <strong>MISSION</strong>
                <small>FLIGHT SESSION</small>
              </span>

              <span class="quick-card__arrow">↗</span>
            </button>

            <button
              class="quick-card"
              data-go="data"
              type="button"
            >
              <span class="quick-card__icon">▦</span>

              <span class="quick-card__main">
                <strong>DAILY DATA</strong>
                <small>22 SEP 2026</small>
              </span>

              <span class="quick-card__arrow">↗</span>
            </button>

            <button
              class="quick-card"
              data-go="more"
              type="button"
            >
              <span class="quick-card__icon">◇</span>

              <span class="quick-card__main">
                <strong>CALIBRATE</strong>
                <small>3 PANEL REFERENCE</small>
              </span>

              <span class="quick-card__arrow">↗</span>
            </button>
          </div>

          <!-- TODAY -->
          <div class="section-label">
            <span>04 / TODAY</span>
            <span class="section-line"></span>
            <span>22 SEP</span>
          </div>

          <article class="today-card">
            <div class="today-card__top">
              <div>
                <span class="micro-label">
                  ACTIVE SESSION
                </span>

                <strong>
                  FIELD 01 / MORNING PASS
                </strong>
              </div>

              <span class="session-status">
                <span></span>
                READY
              </span>
            </div>

            <div class="today-stats">
              <div>
                <span>CAPTURES</span>
                <strong id="todayCaptureCount">
                  1,842
                </strong>
              </div>

              <div>
                <span>TRACK</span>
                <strong>12.6 KM</strong>
              </div>

              <div>
                <span>AREA</span>
                <strong>84.7 HA</strong>
              </div>
            </div>

            <div class="progress-track">
              <span style="width:68%"></span>
            </div>

            <div class="today-card__footer">
              <span>MISSION COMPLETION</span>
              <strong>68%</strong>
            </div>
          </article>

          <!-- SYSTEM CHECK -->
          <div class="section-label">
            <span>05 / SYSTEM CHECK</span>
            <span class="section-line"></span>
            <span>READY</span>
          </div>

          <div class="check-list">
            <div class="check-row">
              <span class="check-icon">✓</span>

              <div>
                <strong>CAMERA LINK</strong>
                <small>DEVICE CHANNEL AVAILABLE</small>
              </div>

              <b>OK</b>
            </div>

            <div class="check-row">
              <span class="check-icon">✓</span>

              <div>
                <strong>GNSS PPK</strong>
                <small>FIXED POSITION</small>
              </div>

              <b>OK</b>
            </div>

            <div class="check-row">
              <span class="check-icon">✓</span>

              <div>
                <strong>STORAGE</strong>
                <small>21.2 GB REMAINING</small>
              </div>

              <b>OK</b>
            </div>

            <div class="check-row">
              <span class="check-icon">✓</span>

              <div>
                <strong>SYNC QUEUE</strong>
                <small>18 RECORDS WAITING</small>
              </div>

              <b>READY</b>
            </div>
          </div>
        </section>

        <!-- =======================================================
             CAMERA
        ======================================================== -->
        <section
          class="screen"
          id="screen-camera"
          data-screen="camera"
        >
          <div class="screen-head">
            <div>
              <div class="eyebrow">ACQUISITION</div>
              <h1>Camera</h1>
              <p>
                Capture and monitor the current LandCam frame.
              </p>
            </div>

            <div class="screen-head__meta">
              <span>LC-4</span>
              <strong>04 BANDS</strong>
            </div>
          </div>

          <article class="capture-panel">
            <div class="capture-panel__bar">
              <div class="camera-status">
                <span></span>
                DEVICE READY
              </div>

              <div class="frame-counter">
                FRAME
                <strong id="cameraFrameCounter">
                  001842
                </strong>
              </div>
            </div>

            <div
              class="camera-preview camera-preview--large"
              id="cameraPreview"
            >
              <div class="preview-grid"></div>
              <div class="preview-scan"></div>
              <div class="preview-horizon"></div>

              <div class="preview-field preview-field--large">
                <div class="field-block field-block--a"></div>
                <div class="field-block field-block--b"></div>
                <div class="field-block field-block--c"></div>
                <div class="field-track"></div>
                <div class="field-track field-track--two"></div>
              </div>

              <div
                class="preview-crosshair preview-crosshair--large"
              >
                <span></span>
                <i></i>
              </div>

              <div class="preview-readout preview-readout--top">
                <span>MODE</span>
                <strong id="previewMode">
                  RGB
                </strong>
              </div>

              <div class="preview-readout preview-readout--bottom">
                <span>FRAME CHANNEL</span>
                <strong>RGB-NIR</strong>
              </div>

              <div
                class="capture-flash"
                id="captureFlash"
              ></div>
            </div>

            <div class="band-strip">
              <button
                class="band-item is-active"
                data-band="B"
                type="button"
              >
                <span class="band-item__index">01</span>
                <strong>BLUE</strong>
                <small>B</small>
              </button>

              <button
                class="band-item"
                data-band="G"
                type="button"
              >
                <span class="band-item__index">02</span>
                <strong>GREEN</strong>
                <small>G</small>
              </button>

              <button
                class="band-item"
                data-band="R"
                type="button"
              >
                <span class="band-item__index">03</span>
                <strong>RED</strong>
                <small>R</small>
              </button>

              <button
                class="band-item"
                data-band="NIR"
                type="button"
              >
                <span class="band-item__index">04</span>
                <strong>NIR</strong>
                <small>NIR</small>
              </button>
            </div>

            <div class="capture-actions">
              <button
                class="capture-secondary"
                id="frameModeButton"
                type="button"
              >
                <span>DISPLAY</span>
                <strong id="frameModeLabel">
                  RGB
                </strong>
              </button>

              <button
                class="shutter-button"
                data-action="capture"
                type="button"
              >
                <span class="shutter-ring">
                  <i></i>
                </span>
                <strong>CAPTURE</strong>
              </button>

              <button
                class="capture-secondary"
                id="triggerModeButton"
                type="button"
              >
                <span>TRIGGER</span>
                <strong id="triggerModeLabel">
                  SINGLE
                </strong>
              </button>
            </div>
          </article>

          <div class="section-label">
            <span>01 / CAPTURE METADATA</span>
            <span class="section-line"></span>
            <span>AUTO</span>
          </div>

          <div class="metadata-grid">
            <div class="meta-tile">
              <span>TIME</span>
              <strong id="captureTime">
                08:42:31
              </strong>
            </div>

            <div class="meta-tile">
              <span>LAT</span>
              <strong>-7.79561</strong>
            </div>

            <div class="meta-tile">
              <span>LON</span>
              <strong>110.36949</strong>
            </div>

            <div class="meta-tile">
              <span>ALT</span>
              <strong>98.4 M</strong>
            </div>

            <div class="meta-tile">
              <span>GNSS</span>
              <strong class="value-ok">FIX</strong>
            </div>

            <div class="meta-tile">
              <span>PPS</span>
              <strong class="value-ok">LOCKED</strong>
            </div>
          </div>

          <div class="section-label">
            <span>02 / BAND OVERVIEW</span>
            <span class="section-line"></span>
            <span>4 / 4</span>
          </div>

          <div class="band-overview">
            {bands.map((band) => (
              <div class="band-overview__row">
                <div class="band-name">
                  <span
                    class={`band-dot band-dot--${band.key.toLowerCase()}`}
                  ></span>

                  {band.name}
                </div>

                <div class="band-value">
                  {band.value}
                </div>

                <div class="band-bar">
                  <span
                    style={`width:${band.key === "B" ? "24%" : band.key === "G" ? "48%" : band.key === "R" ? "20%" : "76%"}`}
                  ></span>
                </div>

                <div class="band-unit">
                  DN
                </div>
              </div>
            ))}
          </div>

          <div class="notice-card">
            <span class="notice-mark">!</span>

            <div>
              <strong>PREVIEW CHANNEL</strong>

              <p>
                UI-only display. The actual LC-4 transport,
                live frame protocol, trigger protocol, and image
                transfer layer will be connected later.
              </p>
            </div>
          </div>
        </section>

        <!-- =======================================================
             MISSION
        ======================================================== -->
        <section
          class="screen"
          id="screen-mission"
          data-screen="mission"
        >
          <div class="screen-head">
            <div>
              <div class="eyebrow">FIELD OPERATION</div>
              <h1>Mission</h1>
              <p>
                Prepare and run one acquisition session.
              </p>
            </div>

            <div class="screen-head__meta">
              <span>SESSION 01</span>
              <strong id="missionStatusTop">
                READY
              </strong>
            </div>
          </div>

          <article class="mission-hero">
            <div class="mission-hero__head">
              <div>
                <span class="micro-label">
                  CURRENT MISSION
                </span>

                <h2>
                  FIELD 01 / MORNING PASS
                </h2>

                <p>
                  Kebun Trial Site — Block A
                </p>
              </div>

              <span
                class="mission-tag"
                id="missionBadge"
              >
                READY
              </span>
            </div>

            <div class="mission-hero__stats">
              <div>
                <span>START</span>
                <strong>08:10</strong>
              </div>

              <div>
                <span>CAPTURE</span>
                <strong id="missionCaptureCount">
                  1,842
                </strong>
              </div>

              <div>
                <span>ALTITUDE</span>
                <strong>100 M</strong>
              </div>

              <div>
                <span>RATE</span>
                <strong>1.0 S</strong>
              </div>
            </div>
          </article>

          <div class="section-label">
            <span>01 / FLIGHT TRACK</span>
            <span class="section-line"></span>
            <span>GPS</span>
          </div>

          <article class="map-card">
            <div class="map-grid"></div>

            <div class="map-route">
              <span class="map-point map-point--start"></span>
              <span class="map-point map-point--end"></span>

              <svg
                viewBox="0 0 600 300"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path
                  d="M80,250 C120,205 115,100 220,125 C325,150 278,50 388,72 C492,94 440,190 530,120"
                />
              </svg>
            </div>

            <div class="map-overlay map-overlay--top">
              <span>TRACK</span>
              <strong>12.6 KM</strong>
            </div>

            <div class="map-overlay map-overlay--bottom">
              <span>POSITION</span>
              <strong>
                -7.79561 / 110.36949
              </strong>
            </div>

            <div class="map-center">
              <span></span>
            </div>
          </article>

          <div class="section-label">
            <span>02 / PRE-FLIGHT</span>
            <span class="section-line"></span>
            <span id="preflightStatus">
              05 / 05
            </span>
          </div>

          <div class="preflight-list">
            <label class="preflight-row">
              <input type="checkbox" checked />
              <span class="custom-check"></span>

              <span class="preflight-copy">
                <strong>CAMERA CONNECTED</strong>
                <small>
                  LC-4 communication channel
                </small>
              </span>

              <b>READY</b>
            </label>

            <label class="preflight-row">
              <input type="checkbox" checked />
              <span class="custom-check"></span>

              <span class="preflight-copy">
                <strong>GNSS FIXED</strong>
                <small>
                  RTK / PPK position source
                </small>
              </span>

              <b>READY</b>
            </label>

            <label class="preflight-row">
              <input type="checkbox" checked />
              <span class="custom-check"></span>

              <span class="preflight-copy">
                <strong>PPS LOCKED</strong>
                <small>Time synchronization</small>
              </span>

              <b>READY</b>
            </label>

            <label class="preflight-row">
              <input type="checkbox" checked />
              <span class="custom-check"></span>

              <span class="preflight-copy">
                <strong>STORAGE AVAILABLE</strong>
                <small>21.2 GB free</small>
              </span>

              <b>READY</b>
            </label>

            <label class="preflight-row">
              <input type="checkbox" checked />
              <span class="custom-check"></span>

              <span class="preflight-copy">
                <strong>CALIBRATION LOADED</strong>
                <small>
                  Reference profile A-03
                </small>
              </span>

              <b>READY</b>
            </label>
          </div>

          <div class="section-label">
            <span>03 / MISSION PLAN</span>
            <span class="section-line"></span>
            <span>ACTIVE CONFIG</span>
          </div>

          <div class="mission-config-grid">
            <div class="config-card">
              <span>TRIGGER</span>
              <strong>AUTO</strong>
              <small>1.0 SEC INTERVAL</small>
            </div>

            <div class="config-card">
              <span>CAPTURE</span>
              <strong>RGB-NIR</strong>
              <small>4 SPECTRAL BANDS</small>
            </div>

            <div class="config-card">
              <span>POSITION</span>
              <strong>PPK</strong>
              <small>GNSS TIMESTAMPED</small>
            </div>

            <div class="config-card">
              <span>OUTPUT</span>
              <strong>LOCAL</strong>
              <small>SYNC QUEUE ENABLED</small>
            </div>
          </div>

          <div class="mission-actions">
            <button
              class="wide-button wide-button--primary"
              id="missionStart"
              type="button"
            >
              <span id="missionStartText">
                START MISSION
              </span>
              <span class="button-arrow">→</span>
            </button>

            <button
              class="wide-button"
              id="missionStop"
              type="button"
            >
              <span>STOP SESSION</span>
              <span class="button-arrow">■</span>
