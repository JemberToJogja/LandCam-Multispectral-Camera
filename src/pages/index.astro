          data-nav="mission"
          type="button"
        >
          <span class="bottom-nav__icon">◎</span>
          <span>MISSION</span>
        </button>

        <button
          class="bottom-nav__item"
          data-nav="data"
          type="button"
        >
          <span class="bottom-nav__icon">▦</span>
          <span>DATA</span>
        </button>

        <button
          class="bottom-nav__item"
          data-nav="more"
          type="button"
        >
          <span class="bottom-nav__icon">⋯</span>
          <span>MORE</span>
        </button>
      </nav>

      <!-- =========================================================
           DEVICE PICKER
      ========================================================== -->
      <div
        class="device-modal"
        id="deviceModal"
        aria-hidden="true"
      >
        <button
          class="device-modal__backdrop"
          id="deviceModalBackdrop"
          type="button"
          aria-label="Close device list"
        ></button>

        <div
          class="device-sheet"
          role="dialog"
          aria-modal="true"
          aria-labelledby="deviceModalTitle"
        >
          <div class="device-sheet__grab"></div>

          <div class="device-sheet__head">
            <div>
              <span class="eyebrow">
                HARDWARE
              </span>

              <h2 id="deviceModalTitle">
                Device List
              </h2>

              <p>
                Select the LandCam controller target.
              </p>
            </div>

            <button
              class="device-sheet__close"
              id="deviceModalClose"
              type="button"
              aria-label="Close device list"
            >
              ×
            </button>
          </div>

          <div class="device-scanbar">
            <div>
              <span class="device-scanbar__dot"></span>
              <span id="deviceScanStatus">
                LAST SCAN 08:41:56
              </span>
            </div>

            <button
              id="scanDevices"
              type="button"
            >
              RESCAN
            </button>
          </div>

          <div
            class="device-list"
            id="deviceList"
          >
            <button
              class="device-option is-selected"
              data-device-id="DEMO-LC4-001"
              type="button"
            >
              <span class="device-option__indicator"></span>

              <span class="device-option__main">
                <strong>LC-4 SPECTRA</strong>

                <small>
                  DEMO-LC4-001 · PPK
                </small>

                <em>RGB · GREEN · RED · NIR</em>
              </span>

              <span class="device-option__meta">
                <b>CONNECTED</b>
                <span>87%</span>
              </span>
            </button>

            <button
              class="device-option"
              data-device-id="DEMO-LC4-002"
              type="button"
            >
              <span class="device-option__indicator"></span>

              <span class="device-option__main">
                <strong>LC-4 SPECTRA</strong>

                <small>
                  DEMO-LC4-002 · PPK
                </small>

                <em>RGB · GREEN · RED · NIR</em>
              </span>

              <span class="device-option__meta device-option__meta--idle">
                <b>AVAILABLE</b>
                <span>91%</span>
              </span>
            </button>

            <button
              class="device-option"
              data-device-id="DEMO-LC4-003"
              type="button"
            >
              <span class="device-option__indicator"></span>

              <span class="device-option__main">
                <strong>LC-4 SPECTRA</strong>

                <small>
                  DEMO-LC4-003 · PPK
                </small>

                <em>RGB · GREEN · RED · NIR</em>
              </span>

              <span class="device-option__meta device-option__meta--offline">
                <b>OFFLINE</b>
                <span>—</span>
              </span>
            </button>
          </div>

          <div class="device-sheet__footer">
            <span>
              3 DEVICES DISCOVERED
            </span>

            <button
              class="device-connect-button"
              id="deviceConnectButton"
              type="button"
            >
              CONNECT SELECTED
              <span>→</span>
            </button>
          </div>
        </div>
      </div>

      <!-- =========================================================
           TOAST
      ========================================================== -->
      <div
        class="toast"
        id="toast"
        role="status"
        aria-live="polite"
      >
        <span class="toast__dot"></span>
        <span id="toastText">
          Capture saved
        </span>
      </div>
    </div>

    <script is:inline>
      /* ============================================================
         STATE
      ============================================================ */
      const screens = [
        ...document.querySelectorAll("[data-screen]"),
      ];

      const navItems = [
        ...document.querySelectorAll("[data-nav]"),
      ];

      const toast = document.getElementById("toast");
      const toastText = document.getElementById("toastText");

      const deviceModal = document.getElementById(
        "deviceModal",
      );

      const deviceModalBackdrop =
        document.getElementById(
          "deviceModalBackdrop",
        );

      const deviceModalClose =
        document.getElementById(
          "deviceModalClose",
        );

      const deviceConnectButton =
        document.getElementById(
          "deviceConnectButton",
        );

      const deviceManageButton =
        document.getElementById(
          "deviceManageButton",
        );

      const topConnect =
        document.getElementById("topConnect");

      const connectButton =
        document.getElementById("connectButton");

      const systemLabel =
        document.getElementById("systemLabel");

      const systemDot =
        document.getElementById("systemDot");

      const connectLabel =
        document.getElementById("connectLabel");

      const topDeviceName =
        document.getElementById("topDeviceName");

      const homeDeviceName =
        document.getElementById("homeDeviceName");

      const homeDeviceId =
        document.getElementById("homeDeviceId");

      const homeFirmware =
        document.getElementById("homeFirmware");

      const homeBattery =
        document.getElementById("homeBattery");

      const deviceDetailName =
        document.getElementById(
          "deviceDetailName",
        );

      const deviceDetailId =
        document.getElementById(
          "deviceDetailId",
        );

      const deviceDetailFirmware =
        document.getElementById(
          "deviceDetailFirmware",
        );

      const deviceManageName =
        document.getElementById(
          "deviceManageName",
        );

      const deviceList = document.getElementById(
        "deviceList",
      );

      const deviceScanStatus =
        document.getElementById(
          "deviceScanStatus",
        );

      const deviceOptions = [
        ...document.querySelectorAll(
          ".device-option",
        ),
      ];

      const deviceDatabase = {
        "DEMO-LC4-001": {
          name: "LC-4 SPECTRA",
          id: "LANDCAM / DEMO-LC4-001",
          shortId: "DEMO-LC4-001",
          firmware: "1.0.0",
          battery: "87%",
          model: "LC-4",
          state: "CONNECTED",
        },

        "DEMO-LC4-002": {
          name: "LC-4 SPECTRA",
          id: "LANDCAM / DEMO-LC4-002",
          shortId: "DEMO-LC4-002",
          firmware: "1.0.2",
          battery: "91%",
          model: "LC-4",
          state: "AVAILABLE",
        },

        "DEMO-LC4-003": {
          name: "LC-4 SPECTRA",
          id: "LANDCAM / DEMO-LC4-003",
          shortId: "DEMO-LC4-003",
          firmware: "—",
          battery: "—",
          model: "LC-4",
          state: "OFFLINE",
        },
      };

      let selectedDeviceId = "DEMO-LC4-001";
      let captureCount = 1842;
      let missionRunning = false;
      let syncPending = 18;
      let frameNumber = 1842;

      /* ============================================================
         TOAST
      ============================================================ */
      function showToast(message) {
        toastText.textContent = message;
        toast.classList.add("is-visible");

        window.clearTimeout(
          window.__toastTimer,
        );

        window.__toastTimer = window.setTimeout(
          () => {
            toast.classList.remove(
              "is-visible",
            );
          },
          2300,
        );
      }

      /* ============================================================
         SCREEN NAVIGATION
      ============================================================ */
      function showScreen(name) {
        screens.forEach((screen) => {
          screen.classList.toggle(
            "is-active",
            screen.dataset.screen === name,
          );
        });

        navItems.forEach((item) => {
          item.classList.toggle(
            "is-active",
            item.dataset.nav === name,
          );
        });

        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });
      }

      document
        .querySelectorAll("[data-go]")
        .forEach((button) => {
          button.addEventListener(
            "click",
            () => {
              showScreen(
                button.dataset.go,
              );
            },
          );
        });

      navItems.forEach((item) => {
        item.addEventListener(
          "click",
          () => {
            showScreen(
              item.dataset.nav,
            );
          },
        );
      });

      /* ============================================================
         DEVICE MODAL
      ============================================================ */
      function openDeviceModal() {
        deviceModal.classList.add(
          "is-open",
        );

        deviceModal.setAttribute(
          "aria-hidden",
          "false",
        );

        topConnect.setAttribute(
          "aria-expanded",
          "true",
        );

        connectButton.setAttribute(
          "aria-expanded",
          "true",
        );

        document.body.classList.add(
          "modal-open",
        );
      }

      function closeDeviceModal() {
        deviceModal.classList.remove(
          "is-open",
        );

        deviceModal.setAttribute(
          "aria-hidden",
          "true",
        );

        topConnect.setAttribute(
          "aria-expanded",
          "false",
        );

        connectButton.setAttribute(
          "aria-expanded",
          "false",
        );

        document.body.classList.remove(
          "modal-open",
        );
      }

      topConnect.addEventListener(
        "click",
        openDeviceModal,
      );

      connectButton.addEventListener(
        "click",
        openDeviceModal,
      );

      deviceManageButton.addEventListener(
        "click",
        openDeviceModal,
      );

      deviceModalBackdrop.addEventListener(
        "click",
        closeDeviceModal,
      );

      deviceModalClose.addEventListener(
        "click",
        closeDeviceModal,
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            event.key === "Escape" &&
            deviceModal.classList.contains(
              "is-open",
            )
          ) {
            closeDeviceModal();
          }
        },
      );

      /* ============================================================
         DEVICE SELECTION
      ============================================================ */
      function updateDeviceUI(device) {
        const isOnline =
          device.state !== "OFFLINE";

        topDeviceName.textContent =
          device.name;

        homeDeviceName.textContent =
          device.name;

        homeDeviceId.textContent =
          device.id;

        homeFirmware.textContent =
          device.firmware;

        homeBattery.textContent =
          device.battery;

        deviceDetailName.textContent =
          device.name;

        deviceDetailId.textContent =
          device.id;

        deviceDetailFirmware.textContent =
          device.firmware;

        deviceManageName.textContent =
          device.name;

        connectLabel.textContent =
          isOnline
            ? "CONNECTED"
            : "OFFLINE";

        systemLabel.textContent =
          isOnline
            ? "SYSTEM READY"
            : "DEVICE OFFLINE";

        systemDot.classList.toggle(
          "is-offline",
          !isOnline,
        );

        connectButton.classList.toggle(
          "status-pill--online",
          isOnline,
        );
      }

      function selectDevice(deviceId) {
        selectedDeviceId = deviceId;

        deviceOptions.forEach((option) => {
          option.classList.toggle(
            "is-selected",
            option.dataset.deviceId ===
              deviceId,
          );
        });
      }

      function connectSelectedDevice() {
        const device =
          deviceDatabase[
            selectedDeviceId
          ];

        if (!device) return;

        if (
          device.state === "OFFLINE"
        ) {
          showToast(
            "Device is currently offline",
          );

          return;
        }

        updateDeviceUI(device);
        closeDeviceModal();

        showToast(
          `${device.shortId} connected`,
        );
      }

      deviceOptions.forEach((option) => {
        option.addEventListener(
          "click",
          () => {
            selectDevice(
              option.dataset.deviceId,
            );
          },
        );
      });

      deviceConnectButton.addEventListener(
        "click",
        connectSelectedDevice,
      );

      document
        .getElementById("scanDevices")
        .addEventListener(
          "click",
          (event) => {
            const button =
              event.currentTarget;

            button.textContent =
              "SCANNING...";

            deviceScanStatus.textContent =
              "SCANNING DEVICE BUS...";

            window.setTimeout(() => {
              button.textContent =
                "RESCAN";

              deviceScanStatus.textContent =
                "LAST SCAN 08:42:04";

              showToast(
                "3 devices discovered",
              );
            }, 900);
          },
        );

      /* ============================================================
         CAPTURE
      ============================================================ */
      function pad(
        number,
        digits = 6,
      ) {
        return String(number).padStart(
          digits,
          "0",
        );
      }

      function currentClock() {
        const now = new Date();

        return now.toLocaleTimeString(
          "en-GB",
          {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
          },
        );
      }

      function simulateCapture() {
        const activeDevice =
          deviceDatabase[
            selectedDeviceId
          ];

        if (
          !activeDevice ||
          activeDevice.state ===
            "OFFLINE"
        ) {
          showToast(
            "Connect a device first",
          );

          return;
        }

        captureCount += 1;
        frameNumber += 1;
        syncPending += 1;

        const now =
          currentClock();

        document.getElementById(
          "homeCaptureCount",
        ).textContent =
          captureCount
            .toLocaleString(
              "en-US",
            )
            .padStart(
              6,
              "0",
            );

        document.getElementById(
          "todayCaptureCount",
        ).textContent =
          captureCount.toLocaleString(
            "en-US",
          );

        document.getElementById(
          "dailyCount",
        ).textContent =
          captureCount.toLocaleString(
            "en-US",
          );

        document.getElementById(
          "missionCaptureCount",
        ).textContent =
          captureCount.toLocaleString(
            "en-US",
          );

        document.getElementById(
          "syncCount",
        ).textContent =
          syncPending;

        document.getElementById(
          "postgisQueue",
        ).textContent =
          syncPending;

        document.getElementById(
          "cameraFrameCounter",
        ).textContent =
          pad(frameNumber);

        document.getElementById(
          "captureTime",
        ).textContent = now;

        const preview =
          document.getElementById(
            "cameraPreview",
          );

        const flash =
          document.getElementById(
            "captureFlash",
          );

        preview.classList.add(
          "is-capturing",
        );

        flash.classList.add(
          "is-active",
        );

        window.setTimeout(() => {
          preview.classList.remove(
            "is-capturing",
          );

          flash.classList.remove(
            "is-active",
          );
        }, 420);

        showToast(
          `Capture #${pad(frameNumber)} saved`,
        );
      }

      document
        .querySelectorAll(
          '[data-action="capture"]',
        )
        .forEach((button) => {
          button.addEventListener(
            "click",
            simulateCapture,
          );
        });

      /* ============================================================
         CAMERA BANDS
      ============================================================ */
      document
        .querySelectorAll(".band-item")
        .forEach((button) => {
          button.addEventListener(
            "click",
            () => {
              document
                .querySelectorAll(
                  ".band-item",
                )
                .forEach(
                  (item) =>
                    item.classList.remove(
                      "is-active",
                    ),
                );

              button.classList.add(
                "is-active",
              );

              showToast(
                `${button.dataset.band} band selected`,
              );
            },
          );
        });

      /* ============================================================
         CAMERA DISPLAY MODE
      ============================================================ */
      const frameModes = [
        "RGB",
        "NIR",
        "FALSE COLOR",
      ];

      let frameModeIndex = 0;

      document
        .getElementById(
          "frameModeButton",
        )
        .addEventListener(
          "click",
          () => {
            frameModeIndex =
              (frameModeIndex + 1) %
              frameModes.length;

            const mode =
              frameModes[
                frameModeIndex
              ];

            document.getElementById(
              "frameModeLabel",
            ).textContent = mode;

            document.getElementById(
              "previewMode",
            ).textContent = mode;

            showToast(
              `Display mode: ${mode}`,
            );
          },
        );

      /* ============================================================
         TRIGGER MODE
      ============================================================ */
      const triggerModes = [
        "SINGLE",
        "AUTO",
      ];

      let triggerModeIndex = 0;

      document
        .getElementById(
          "triggerModeButton",
        )
        .addEventListener(
          "click",
          () => {
            triggerModeIndex =
              (triggerModeIndex + 1) %
              triggerModes.length;

            const mode =
              triggerModes[
                triggerModeIndex
              ];

            document.getElementById(
              "triggerModeLabel",
            ).textContent = mode;

            showToast(
              `Trigger mode: ${mode}`,
            );
          },
        );

      /* ============================================================
         MISSION
      ============================================================ */
      const missionStart =
        document.getElementById(
          "missionStart",
        );

      const missionStop =
        document.getElementById(
          "missionStop",
        );

      const missionStartText =
        document.getElementById(
          "missionStartText",
        );

      const missionBadge =
        document.getElementById(
          "missionBadge",
        );

      const missionStatusTop =
        document.getElementById(
          "missionStatusTop",
        );

      missionStart.addEventListener(
        "click",
        () => {
          missionRunning =
            !missionRunning;

          if (
            missionRunning
          ) {
            missionStartText.textContent =
              "MISSION RUNNING";

            missionBadge.textContent =
              "ACTIVE";

            missionBadge.classList.add(
              "mission-tag--active",
            );

            missionStatusTop.textContent =
              "ACTIVE";

            systemLabel.textContent =
              "MISSION ACTIVE";

            showToast(
              "Mission started",
            );
          } else {
            missionStartText.textContent =
              "START MISSION";

            missionBadge.textContent =
              "READY";

            missionBadge.classList.remove(
              "mission-tag--active",
            );

            missionStatusTop.textContent =
              "READY";

            systemLabel.textContent =
              "SYSTEM READY";

            showToast(
              "Mission paused",
            );
          }
        },
      );

      missionStop.addEventListener(
        "click",
        () => {
          missionRunning = false;

          missionStartText.textContent =
            "START MISSION";

          missionBadge.textContent =
            "STOPPED";

          missionBadge.classList.remove(
            "mission-tag--active",
          );

          missionStatusTop.textContent =
            "STOPPED";

          systemLabel.textContent =
            "SYSTEM READY";

          showToast(
            "Mission stopped",
          );
        },
      );

      /* ============================================================
         DATA TABS
      ============================================================ */
      document
        .querySelectorAll(
          "[data-data-tab]",
        )
        .forEach((tab) => {
          tab.addEventListener(
            "click",
            () => {
              document
                .querySelectorAll(
                  "[data-data-tab]",
                )
                .forEach(
                  (item) =>
                    item.classList.remove(
                      "is-active",
                    ),
                );

              document
                .querySelectorAll(
                  ".data-pane",
                )
                .forEach(
                  (pane) =>
                    pane.classList.remove(
                      "is-active",
                    ),
                );

              tab.classList.add(
                "is-active",
              );

              document
                .getElementById(
                  `data-${tab.dataset.dataTab}`,
                )
                .classList.add(
                  "is-active",
                );
            },
          );
        });

      /* ============================================================
         MORE TABS
      ============================================================ */
      document
        .querySelectorAll(
          "[data-more-tab]",
        )
        .forEach((tab) => {
          tab.addEventListener(
            "click",
            () => {
              document
                .querySelectorAll(
                  "[data-more-tab]",
                )
                .forEach(
                  (item) =>
                    item.classList.remove(
                      "is-active",
                    ),
                );

              document
                .querySelectorAll(
                  ".more-pane",
                )
                .forEach(
                  (pane) =>
                    pane.classList.remove(
                      "is-active",
                    ),
                );

              tab.classList.add(
                "is-active",
              );

              document
                .getElementById(
                  `more-${tab.dataset.moreTab}`,
                )
                .classList.add(
                  "is-active",
                );
            },
          );
        });

      /* ============================================================
         TOGGLES
      ============================================================ */
      document
        .querySelectorAll(
          "[data-toggle]",
        )
        .forEach((toggle) => {
          toggle.addEventListener(
            "click",
            () => {
              toggle.classList.toggle(
                "is-on",
              );
            },
          );
        });

      /* ============================================================
         SYNC
      ============================================================ */
      const syncButton =
        document.getElementById(
          "syncButton",
        );

      const syncButtonLabel =
        document.getElementById(
          "syncButtonLabel",
        );

      syncButton.addEventListener(
        "click",
        () => {
          syncPending = 0;

          document.getElementById(
            "syncCount",
          ).textContent = "0";

          document.getElementById(
            "postgisQueue",
          ).textContent = "0";

          syncButtonLabel.textContent =
            "QUEUE SYNCHRONIZED";

          showToast(
            "Local queue synchronized",
          );

          window.setTimeout(() => {
            syncButtonLabel.textContent =
              "SYNC QUEUE";
          }, 1800);
        },
      );

      /* ============================================================
         LOAD MORE
      ============================================================ */
      document
        .getElementById("loadMore")
        .addEventListener(
          "click",
          (event) => {
            event.currentTarget.innerHTML =
              'ALL VISIBLE CAPTURES LOADED <span>✓</span>';

            showToast(
              "Daily capture list expanded",
            );
          },
        );

      /* ============================================================
         CALIBRATION
      ============================================================ */
      document
        .querySelectorAll(
          ".panel-button",
        )
        .forEach((button) => {
          button.addEventListener(
            "click",
            () => {
              button.textContent =
                "REFERENCE CAPTURED";

              button.classList.add(
                "is-done",
              );

              showToast(
                "Reference panel capture stored",
              );
            },
          );
        });

      /* ============================================================
         DATE
      ============================================================ */
      document
        .querySelectorAll(
          ".date-arrow",
        )
        .forEach((button) => {
          button.addEventListener(
            "click",
            () => {
              showToast(
                "Date navigation is UI-only in this prototype",
              );
            },
          );
        });

      /* ============================================================
         THEME
      ============================================================ */
      const themeOptions = [
        ...document.querySelectorAll(
          "[data-theme-choice]",
        ),
      ];

      const themeCurrent =
        document.getElementById(
          "themeCurrent",
        );

      const themeColor =
        document.getElementById(
          "themeColor",
        );

      function applyTheme(theme) {
        const normalizedTheme =
          theme === "light"
            ? "light"
            : "dark";

        document.documentElement.dataset.theme =
          normalizedTheme;

        themeOptions.forEach(
          (option) => {
            option.classList.toggle(
              "is-active",
              option.dataset.themeChoice ===
                normalizedTheme,
            );
          },
        );

        themeCurrent.textContent =
          normalizedTheme.toUpperCase();

        themeColor.setAttribute(
          "content",
          normalizedTheme === "light"
            ? "#f3f4ef"
            : "#090b0a",
        );

        try {
          localStorage.setItem(
            "landcam-theme",
            normalizedTheme,
          );
        } catch {}
      }

      let savedTheme = "dark";

      try {
        savedTheme =
          localStorage.getItem(
            "landcam-theme",
          ) || "dark";
      } catch {}

      applyTheme(savedTheme);

      themeOptions.forEach(
        (option) => {
          option.addEventListener(
            "click",
            () => {
              applyTheme(
                option.dataset.themeChoice,
              );

              showToast(
                `${option.dataset.themeChoice.toUpperCase()} theme selected`,
              );
            },
          );
        },
      );
    </script>

    <style is:global>
      /* ==========================================================
         THEME TOKENS
      =========================================================== */
      :root {
        color-scheme: dark;

        --bg: #090b0a;
        --surface: #0e1110;
        --surface-2: #131715;
        --surface-3: #171c19;

        --line: rgba(255, 255, 255, 0.09);
        --line-strong: rgba(255, 255, 255, 0.15);

        --text: #f3f5f1;
        --muted: #8b938d;
        --muted-2: #646c66;

        --green: #c6f56e;
        --green-2: #9bd94f;

        --amber: #f0bd67;
        --red: #ff6e69;
        --blue: #7db7ff;

        --radius: 16px;
        --radius-small: 11px;

        --nav-h: 74px;
        --topbar-h: 70px;

        --shadow:
          0 20px 50px rgba(0, 0, 0, 0.38);
      }

      :root[data-theme="light"] {
        color-scheme: light;

        --bg: #f2f3ef;
        --surface: #ffffff;
        --surface-2: #f7f8f5;
        --surface-3: #eceee9;

        --line: rgba(20, 26, 22, 0.11);
        --line-strong: rgba(20, 26, 22, 0.18);

        --text: #111511;
        --muted: #69716b;
        --muted-2: #8a918b;

        --green: #587f1e;
        --green-2: #6d992a;

        --amber: #99691e;
        --red: #b3413c;
        --blue: #3974ad;

        --shadow:
          0 20px 50px rgba(24, 30, 26, 0.12);
      }

      /* ==========================================================
         RESET
      =========================================================== */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        min-width: 320px;
        background: var(--bg);
        scroll-behavior: smooth;
        transition:
          background 0.22s ease,
          color 0.22s ease;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--text);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        -webkit-font-smoothing: antialiased;
        transition:
          background 0.22s ease,
          color 0.22s ease;
      }

      body.modal-open {
        overflow: hidden;
      }

      button,
      input {
        font: inherit;
      }

      button {
        border: 0;
        color: inherit;
        background: none;
        cursor: pointer;
      }

      button:focus-visible,
      input:focus-visible {
        outline: 2px solid var(--green);
        outline-offset: 3px;
      }

      ::selection {
        background: var(--green);
        color: #081008;
      }

      /* ==========================================================
         APP
      =========================================================== */
      .app {
        min-height: 100vh;
        padding-bottom: calc(
          var(--nav-h) + 20px
        );
      }

      .main {
        width: min(1180px, 100%);
        margin: 0 auto;
        padding: 28px 18px 30px;
      }

      /* ==========================================================
         TOPBAR
      =========================================================== */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 100;
        min-height: var(--topbar-h);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 18px;
        border-bottom: 1px solid var(--line);
        background: color-mix(
          in srgb,
          var(--bg) 94%,
          transparent
        );
        backdrop-filter: blur(18px);
        transition:
          background 0.22s ease,
          border-color 0.22s ease;
      }

      .topbar__brand {
        display: flex;
        align-items: center;
        gap: 11px;
      }

      .brand-mark {
        position: relative;
        width: 26px;
        height: 26px;
        display: block;
        border: 1px solid var(--green);
        background:
          linear-gradient(
            90deg,
            transparent 46%,
            var(--green) 46%,
            var(--green) 54%,
            transparent 54%
          ),
          linear-gradient(
            0deg,
            transparent 46%,
            var(--green) 46%,
            var(--green) 54%,
            transparent 54%
          );
        box-shadow:
          5px 5px 0
          color-mix(
            in srgb,
            var(--green) 12%,
            transparent
          );
      }

      .brand-name {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0.1em;
      }

      .brand-sub {
        margin-top: 2px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .topbar__center {
        justify-self: center;
      }

      .system-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .system-dot,
      .status-pill__dot,
      .device-trigger__status {
        width: 6px;
        height: 6px;
        flex: 0 0 auto;
        border-radius: 999px;
        background: var(--green);
        box-shadow:
          0 0 12px
          color-mix(
            in srgb,
            var(--green) 72%,
            transparent
          );
      }

      .system-dot.is-offline,
      .status-pill:not(.status-pill--online)
        .status-pill__dot {
        background: var(--red);
        box-shadow:
          0 0 12px
          color-mix(
            in srgb,
            var(--red) 55%,
            transparent
          );
      }

      /* DEVICE TRIGGER */
      .topbar__right {
        justify-self: end;
      }

      .device-trigger {
        min-height: 42px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface);
        text-align: left;
      }

      .device-trigger__copy {
        display: grid;
        gap: 2px;
      }

      .device-trigger__copy small,
      .device-trigger__copy strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .device-trigger__copy small {
        color: var(--muted);
        font-size: 6px;
        letter-spacing: 0.08em;
      }

      .device-trigger__copy strong {
        max-width: 126px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 7px;
        letter-spacing: 0.08em;
      }

      .device-trigger__chevron {
        color: var(--muted);
        font-size: 12px;
        line-height: 1;
      }

      /* ==========================================================
         SCREEN
      =========================================================== */
      .screen {
        display: none;
      }

      .screen.is-active {
        display: block;
        animation: screenIn 0.25s ease both;
      }

      @keyframes screenIn {
        from {
          opacity: 0;
          transform: translateY(5px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .screen-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 26px;
      }

      .screen-head h1 {
        margin-top: 5px;
        font-size: clamp(29px, 7vw, 50px);
        line-height: 0.95;
        letter-spacing: -0.045em;
        font-weight: 800;
      }

      .screen-head p {
        max-width: 510px;
        margin-top: 9px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.55;
      }

      .eyebrow,
      .micro-label {
        color: var(--green);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.14em;
      }

      .screen-head__meta {
        flex-shrink: 0;
        display: grid;
        gap: 4px;
        text-align: right;
      }

      .screen-head__meta span,
      .screen-head__meta strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .screen-head__meta span {
        color: var(--muted);
        font-size: 8px;
        letter-spacing: 0.1em;
      }

      .screen-head__meta strong {
        font-size: 10px;
        letter-spacing: 0.08em;
      }

      /* ==========================================================
         DEVICE CARD
      =========================================================== */
      .device-card {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background:
          linear-gradient(
            135deg,
            color-mix(
              in srgb,
              var(--text) 2.4%,
              transparent
            ),
            transparent 55%
          ),
          var(--surface);
      }

      .device-card__top,
      .device-card__bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .device-card__top {
        padding: 22px;
      }

      .device-card__bottom {
        padding: 14px 22px;
        border-top: 1px solid var(--line);
        background: color-mix(
          in srgb,
          var(--surface) 92%,
          var(--text)
        );
      }

      .device-name {
        margin-top: 6px;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      .device-id {
        margin-top: 5px;
        color: var(--muted-2);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        letter-spacing: 0.08em;
      }

      .device-card__bottom > div {
        display: grid;
        gap: 5px;
      }

      .device-card__bottom strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 10px;
        letter-spacing: 0.05em;
      }

      /* ==========================================================
         STATUS
      =========================================================== */
      .status-pill {
        min-width: 92px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 8px 10px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .status-pill--online {
        color: var(--green);
        border-color:
          color-mix(
            in srgb,
            var(--green) 20%,
            transparent
          );
        background:
          color-mix(
            in srgb,
            var(--green) 5%,
            transparent
          );
      }

      /* ==========================================================
         SECTION LABEL
      =========================================================== */
      .section-label {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 10px;
        margin: 28px 0 12px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.12em;
      }

      .section-label--first {
        margin-top: 6px;
      }

      .section-line {
        height: 1px;
        background: var(--line);
      }

      /* ==========================================================
         TELEMETRY
      =========================================================== */
      .telemetry-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
      }

      .telemetry-card {
        min-height: 115px;
        display: grid;
        align-content: space-between;
        padding: 15px;
        border: 1px solid var(--line);
        border-radius: var(--radius-small);
        background: var(--surface);
      }

      .telemetry-card__label,
      .telemetry-card__meta {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        letter-spacing: 0.1em;
      }

      .telemetry-card__label {
        color: var(--muted);
      }

      .telemetry-card__value {
        margin-top: 5px;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: -0.035em;
      }

      .telemetry-card__meta {
        color: var(--muted-2);
      }

      .value-ok {
        color: var(--green);
      }

      /* ==========================================================
         CAMERA SUMMARY
      =========================================================== */
      .camera-summary {
        display: grid;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        background: var(--surface);
      }

      .camera-summary__info {
        display: grid;
        gap: 17px;
        padding: 18px;
      }

      .camera-summary__head {
        display: flex;
        justify-content: space-between;
        gap: 15px;
      }

      .camera-summary__head > div {
        display: grid;
        gap: 5px;
      }

      .camera-summary__head strong {
        font-size: 20px;
        letter-spacing: -0.035em;
      }

      .mini-badge,
      .validation-badge,
      .mission-tag,
      .connected-tag {
        align-self: start;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 8px;
        border:
          1px solid
          color-mix(
            in srgb,
            var(--green) 16%,
            transparent
          );
        border-radius: 999px;
        color: var(--green);
        background:
          color-mix(
            in srgb,
            var(--green) 5%,
            transparent
          );
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: 0.1em;
      }

      .camera-summary__stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
      }

      .camera-summary__stats > div {
        display: grid;
        gap: 5px;
        padding-top: 11px;
        border-top: 1px solid var(--line);
      }

      .camera-summary__stats span,
      .camera-summary__stats strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .camera-summary__stats span {
        color: var(--muted);
        font-size: 7px;
      }

      .camera-summary__stats strong {
        font-size: 10px;
      }

      /* ==========================================================
         CAMERA PREVIEW
      =========================================================== */
      .camera-preview {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        background:
          linear-gradient(
            155deg,
            color-mix(
              in srgb,
              var(--green) 10%,
              transparent
            ) 0%,
            rgba(65, 84, 59, 0.28) 35%,
            rgba(20, 27, 24, 0.96) 72%
          ),
          #111;
      }

      :root[data-theme="light"]
        .camera-preview {
        background:
          linear-gradient(
            155deg,
            rgba(91, 125, 61, 0.32),
            rgba(173, 180, 163, 0.4) 50%,
            rgba(226, 228, 220, 0.95)
          ),
          #dde0d7;
      }

      .camera-preview--small {
        min-height: 225px;
      }

      .camera-preview--large {
        min-height: min(69vw, 620px);
      }

      .camera-preview::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 8;
        pointer-events: none;
        background:
          linear-gradient(
            transparent 0%,
            rgba(255, 255, 255, 0.018) 48%,
            transparent 50%
          );
        background-size: 100% 5px;
        mix-blend-mode: screen;
        opacity: 0.28;
      }

      .preview-grid {
        position: absolute;
        inset: 0;
        z-index: 1;
        opacity: 0.28;
        background-image:
          linear-gradient(
            rgba(255, 255, 255, 0.05) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.05) 1px,
            transparent 1px
          );
        background-size: 40px 40px;
      }

      .preview-grid::before,
      .preview-grid::after {
        content: "";
        position: absolute;
        background:
          color-mix(
            in srgb,
            var(--green) 22%,
            transparent
          );
      }

      .preview-grid::before {
        left: 50%;
        top: 0;
        width: 1px;
        height: 100%;
      }

      .preview-grid::after {
        left: 0;
        top: 50%;
        width: 100%;
        height: 1px;
      }

      .preview-scan {
        position: absolute;
        inset: 0;
        z-index: 7;
        background:
          linear-gradient(
            to bottom,
            transparent 0%,
            color-mix(
              in srgb,
              var(--green) 0%,
              transparent
            ) 46%,
            color-mix(
              in srgb,
              var(--green) 12%,
              transparent
            ) 50%,
            color-mix(
              in srgb,
              var(--green) 0%,
              transparent
            ) 54%,
            transparent 100%
          );
        animation:
          scan 4.2s linear infinite;
        pointer-events: none;
      }

      @keyframes scan {
        from {
          transform: translateY(-55%);
        }

        to {
          transform: translateY(55%);
        }
      }

      .preview-horizon {
        position: absolute;
        z-index: 2;
        top: 31%;
        left: 0;
        right: 0;
        height: 1px;
        background:
          color-mix(
            in srgb,
            var(--green) 36%,
            transparent
          );
      }

      .preview-field {
        position: absolute;
        inset: 38% -15% -15%;
        transform:
          perspective(400px)
          rotateX(54deg);

        background:
          repeating-linear-gradient(
            90deg,
            color-mix(
              in srgb,
              var(--green) 6%,
              transparent
            )
            0 16px,
            transparent 16px 35px
          );
      }

      .preview-field--large {
        inset: 41% -14% -17%;
      }

      .field-block {
        position: absolute;
        border:
          1px solid
          color-mix(
            in srgb,
            var(--green) 16%,
            transparent
          );
        background:
          color-mix(
            in srgb,
            var(--green) 7%,
            transparent
          );
      }

      .field-block--a {
        left: 4%;
        right: 57%;
        top: 16%;
        bottom: 18%;
      }

      .field-block--b {
        left: 48%;
        right: 7%;
        top: 3%;
        bottom: 36%;
      }

      .field-block--c {
        left: 26%;
        right: 19%;
        top: 34%;
        bottom: 7%;
      }

      .field-track {
        position: absolute;
        left: 35%;
        top: -8%;
        width: 2px;
        height: 125%;
        background: rgba(255, 255, 255, 0.2);
        transform: rotate(-5deg);
        box-shadow:
          12px 0 0 rgba(255, 255, 255, 0.02);
      }

      .field-track--two {
        left: 51%;
        transform: rotate(3deg);
      }

      .preview-crosshair {
        position: absolute;
        z-index: 9;
        top: 50%;
        left: 50%;
        width: 46px;
        height: 46px;
        transform: translate(-50%, -50%);
      }

      .preview-crosshair span,
      .preview-crosshair::before,
      .preview-crosshair::after {
        position: absolute;
        content: "";
      }

      .preview-crosshair span {
        left: 50%;
        top: 50%;
        width: 4px;
        height: 4px;
        transform:
          translate(-50%, -50%);
        border-radius: 50%;
        background: var(--green);
        box-shadow:
          0 0 16px var(--green);
      }

      .preview-crosshair::before {
        left: 50%;
        top: 0;
        width: 1px;
        height: 100%;
        background:
          color-mix(
            in srgb,
            var(--green) 80%,
            transparent
          );
      }

      .preview-crosshair::after {
        left: 0;
        top: 50%;
        width: 100%;
        height: 1px;
        background:
          color-mix(
            in srgb,
            var(--green) 80%,
            transparent
          );
      }

      .preview-crosshair i {
        position: absolute;
        inset: 9px;
        border:
          1px solid
          color-mix(
            in srgb,
            var(--green) 80%,
            transparent
          );
        border-radius: 50%;
      }

      .preview-crosshair--large {
        width: 76px;
        height: 76px;
      }

      .preview-readout,
      .preview-label,
      .preview-tag {
        position: absolute;
        z-index: 10;
        padding: 6px 7px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(5, 7, 6, 0.45);
        backdrop-filter: blur(8px);
        color: rgba(255, 255, 255, 0.82);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        letter-spacing: 0.08em;
      }

      .preview-label {
        left: 12px;
        top: 12px;
      }

      .preview-tag {
        right: 12px;
        top: 12px;
        color: var(--green);
      }

      .preview-readout {
        display: grid;
        gap: 3px;
      }

      .preview-readout span {
        color: rgba(255, 255, 255, 0.55);
      }

      .preview-readout strong {
        color: rgba(255, 255, 255, 0.96);
      }

      .preview-readout--top {
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
      }

      .preview-readout--bottom {
        left: 12px;
        bottom: 12px;
      }

      .capture-flash {
        position: absolute;
        inset: 0;
        z-index: 20;
        pointer-events: none;
        background: white;
        opacity: 0;
      }

      .capture-flash.is-active {
        animation:
          captureFlash 0.42s ease;
      }

      @keyframes captureFlash {
        0% {
          opacity: 0;
        }

        18% {
          opacity: 0.8;
        }

        100% {
          opacity: 0;
        }
      }

      /* ==========================================================
         BUTTONS
      =========================================================== */
      .wide-button {
        width: 100%;
        min-height: 46px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 0 14px;
        border: 1px solid var(--line-strong);
        border-radius: 10px;
        background: var(--surface-2);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 0.1em;
        transition:
          transform 0.18s ease,
          border-color 0.18s ease,
          background 0.18s ease;
      }

      .wide-button:hover {
        transform: translateY(-1px);
        border-color: var(--line-strong);
      }

      .wide-button--primary {
        color:
          color-mix(
            in srgb,
            var(--bg) 95%,
            #000 5%
          );
        border-color: var(--green);
        background: var(--green);
      }

      .button-arrow {
        font-size: 14px;
      }

      /* ==========================================================
         QUICK ACTIONS
      =========================================================== */
      .quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
      }

      .quick-card {
        min-height: 104px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: end;
        gap: 10px;
        padding: 13px;
        text-align: left;
        border: 1px solid var(--line);
        border-radius: var(--radius-small);
        background: var(--surface);
        transition:
          border-color 0.18s ease,
          transform 0.18s ease;
      }

      .quick-card:hover {
        border-color: var(--line-strong);
        transform: translateY(-1px);
      }

      .quick-card--primary {
        border-color:
          color-mix(
            in srgb,
            var(--green) 22%,
            transparent
          );
        background:
          linear-gradient(
            135deg,
            color-mix(
              in srgb,
              var(--green) 13%,
              transparent
            ),
            transparent 65%
          ),
          var(--surface);
      }

      .quick-card__icon {
        align-self: start;
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        color: var(--green);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 15px;
      }

      .quick-card__main {
        display: grid;
        gap: 4px;
      }

      .quick-card__main strong {
        font-size: 10px;
      }

      .quick-card__main small,
      .quick-card__arrow {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        letter-spacing: 0.08em;
      }

      /* ==========================================================
         TODAY
      =========================================================== */
      .today-card {
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .today-card__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
      }

      .today-card__top > div {
        display: grid;
        gap: 5px;
      }

      .today-card__top strong {
        font-size: 15px;
        letter-spacing: -0.025em;
      }

      .session-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--green);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 900;
      }

      .session-status span,
      .camera-status span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--green);
        box-shadow:
          0 0 10px
          color-mix(
            in srgb,
            var(--green) 80%,
            transparent
          );
      }

      .today-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin: 20px 0 16px;
      }

      .today-stats div {
        display: grid;
        gap: 4px;
      }

      .today-stats span,
      .today-stats strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .today-stats span {
        color: var(--muted);
        font-size: 7px;
      }

      .today-stats strong {
        font-size: 13px;
      }

      .progress-track,
      .storage-progress {
        position: relative;
        height: 5px;
        overflow: hidden;
        border-radius: 999px;
        background:
          color-mix(
            in srgb,
            var(--text) 8%,
            transparent
          );
      }

      .progress-track span,
      .storage-progress span {
        position: absolute;
        inset: 0 auto 0 0;
        background: var(--green);
        box-shadow:
          0 0 14px
          color-mix(
            in srgb,
            var(--green) 34%,
            transparent
          );
      }

      .today-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 9px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .today-card__footer strong {
        color: var(--green);
      }

      /* ==========================================================
         CHECK LIST
      =========================================================== */
      .check-list {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .check-row {
        min-height: 66px;
        display: grid;
        grid-template-columns: 25px 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--line);
      }

      .check-row:last-child {
        border-bottom: 0;
      }

      .check-row > div {
        display: grid;
        gap: 4px;
      }

      .check-row strong {
        font-size: 9px;
      }

      .check-row small,
      .check-row b {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .check-row b {
        color: var(--green);
      }

      .check-icon {
        width: 21px;
        height: 21px;
        display: grid;
        place-items: center;
        border-radius: 7px;
        background:
          color-mix(
            in srgb,
            var(--green) 8%,
            transparent
          );
        color: var(--green);
        font-size: 11px;
      }

      /* ==========================================================
         CAMERA PAGE
      =========================================================== */
      .capture-panel {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .capture-panel__bar {
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 0 12px;
        border-bottom: 1px solid var(--line);
      }

      .camera-status,
      .frame-counter {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .camera-status {
        color: var(--green);
      }

      .frame-counter strong {
        color: var(--text);
      }

      .band-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--line);
      }

      .band-item {
        min-height: 76px;
        display: grid;
        align-content: center;
        gap: 4px;
        padding: 9px;
        border-right: 1px solid var(--line);
        text-align: left;
        background:
          color-mix(
            in srgb,
            var(--surface) 98%,
            var(--text)
          );
      }

      .band-item:last-child {
        border-right: 0;
      }

      .band-item.is-active {
        color: var(--green);
        background:
          color-mix(
            in srgb,
            var(--green) 6%,
            transparent
          );
      }

      .band-item__index,
      .band-item small {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .band-item.is-active .band-item__index,
      .band-item.is-active small {
        color:
          color-mix(
            in srgb,
            var(--green) 70%,
            transparent
          );
      }

      .band-item strong {
        font-size: 9px;
      }

      .capture-actions {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        padding: 20px 15px;
        border-top: 1px solid var(--line);
      }

      .capture-secondary {
        min-height: 58px;
        display: grid;
        align-content: center;
        gap: 5px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface-2);
        text-align: center;
      }

      .capture-secondary span,
      .capture-secondary strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .capture-secondary span {
        color: var(--muted);
        font-size: 7px;
      }

      .capture-secondary strong {
        color: var(--green);
        font-size: 8px;
      }

      .shutter-button {
        width: 92px;
        height: 92px;
        display: grid;
        place-items: center;
        gap: 5px;
        border-radius: 50%;
        background: var(--green);
        color:
          color-mix(
            in srgb,
            var(--bg) 95%,
            black
          );
        box-shadow:
          0 0 0 6px
          color-mix(
            in srgb,
            var(--green) 8%,
            transparent
          ),
          var(--shadow);
      }

      .shutter-ring {
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        border: 1px solid
          color-mix(
            in srgb,
            var(--bg) 50%,
            transparent
          );
        border-radius: 50%;
      }

      .shutter-ring i {
        width: 28px;
        height: 28px;
        display: block;
        border-radius: 50%;
        background: var(--bg);
      }

      .shutter-button strong {
        margin-top: -25px;
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        letter-spacing: 0.08em;
      }

      .metadata-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
      }

      .meta-tile {
        display: grid;
        gap: 7px;
        min-height: 75px;
        padding: 12px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface);
      }

      .meta-tile span,
      .meta-tile strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .meta-tile span {
        color: var(--muted);
        font-size: 7px;
      }

      .meta-tile strong {
        font-size: 9px;
      }

      .band-overview {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .band-overview__row {
        min-height: 57px;
        display: grid;
        grid-template-columns: 92px 50px 1fr 28px;
        align-items: center;
        gap: 10px;
        padding: 0 12px;
        border-bottom: 1px solid var(--line);
      }

      .band-overview__row:last-child {
        border-bottom: 0;
      }

      .band-name,
      .band-value,
      .band-unit {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
      }

      .band-name {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .band-value {
        color: var(--text);
        font-weight: 800;
      }

      .band-unit {
        color: var(--muted-2);
        text-align: right;
      }

      .band-dot {
        width: 6px;
        height: 6px;
        display: inline-block;
        border-radius: 50%;
      }

      .band-dot--b {
        background: var(--blue);
      }

      .band-dot--g {
        background: #7ca854;
      }

      .band-dot--r {
        background: #d65450;
      }

      .band-dot--nir {
        background: #b99342;
      }

      .band-bar {
        position: relative;
        height: 5px;
        overflow: hidden;
        border-radius: 999px;
        background:
          color-mix(
            in srgb,
            var(--text) 8%,
            transparent
          );
      }

      .band-bar span {
        position: absolute;
        inset: 0 auto 0 0;
        border-radius: inherit;
        background: var(--green);
      }

      .notice-card {
        display: grid;
        grid-template-columns: 27px 1fr;
        gap: 10px;
        margin-top: 12px;
        padding: 13px;
        border:
          1px solid
          color-mix(
            in srgb,
            var(--amber) 17%,
            transparent
          );
        border-radius: var(--radius-small);
        background:
          color-mix(
            in srgb,
            var(--amber) 4.5%,
            transparent
          );
      }

      .notice-mark {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        border:
          1px solid
          color-mix(
            in srgb,
            var(--amber) 24%,
            transparent
          );
        border-radius: 7px;
        color: var(--amber);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-weight: 900;
      }

      .notice-card strong,
      .notice-card p {
        font-size: 9px;
      }

      .notice-card p {
        margin-top: 4px;
        color: var(--muted);
        line-height: 1.55;
      }

      /* ==========================================================
         MISSION
      =========================================================== */
      .mission-hero {
        padding: 19px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background:
          linear-gradient(
            130deg,
            color-mix(
              in srgb,
              var(--green) 5.5%,
              transparent
            ),
            transparent 60%
          ),
          var(--surface);
      }

      .mission-hero__head {
        display: flex;
        justify-content: space-between;
        gap: 15px;
      }

      .mission-hero__head > div {
        display: grid;
        gap: 5px;
      }

      .mission-hero__head h2 {
        font-size: 18px;
        letter-spacing: -0.035em;
      }

      .mission-hero__head p {
        color: var(--muted);
        font-size: 10px;
      }

      .mission-tag--active {
        border-color:
          color-mix(
            in srgb,
            var(--green) 30%,
            transparent
          );
        background:
          color-mix(
            in srgb,
            var(--green) 12%,
            transparent
          );
      }

      .mission-hero__stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 24px;
      }

      .mission-hero__stats > div {
        display: grid;
        gap: 5px;
      }

      .mission-hero__stats span,
      .mission-hero__stats strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .mission-hero__stats span {
        color: var(--muted);
        font-size: 7px;
      }

      .mission-hero__stats strong {
        font-size: 10px;
      }

      .map-card {
        position: relative;
        height: 330px;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background:
          radial-gradient(
            circle at center,
            color-mix(
              in srgb,
              var(--green) 5%,
              transparent
            ),
            transparent 40%
          ),
          var(--surface);
      }

      .map-grid {
        position: absolute;
        inset: 0;
        opacity: 0.38;
        background-image:
          linear-gradient(
            color-mix(
              in srgb,
              var(--text) 4%,
              transparent
            )
            1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            color-mix(
              in srgb,
              var(--text) 4%,
              transparent
            )
            1px,
            transparent 1px
          );
        background-size: 31px 31px;
      }

      .map-route {
        position: absolute;
        inset: 20px;
      }

      .map-route svg {
        width: 100%;
        height: 100%;
        overflow: visible;
      }

      .map-route path {
        fill: none;
        stroke: var(--green);
        stroke-width: 3;
        vector-effect: non-scaling-stroke;
        stroke-linecap: round;
        filter:
          drop-shadow(
            0 0 8px
            color-mix(
              in srgb,
              var(--green) 18%,
              transparent
            )
          );
      }

      .map-point {
        position: absolute;
        z-index: 4;
        width: 11px;
        height: 11px;
        border: 2px solid var(--bg);
        border-radius: 50%;
        background: var(--green);
        box-shadow:
          0 0 0 5px
          color-mix(
            in srgb,
            var(--green) 11%,
            transparent
          );
      }

      .map-point--start {
        left: 12%;
        bottom: 14%;
      }

      .map-point--end {
        right: 8%;
        top: 35%;
      }

      .map-overlay {
        position: absolute;
        z-index: 5;
        display: grid;
        gap: 4px;
        padding: 8px;
        border: 1px solid var(--line);
        background:
          color-mix(
            in srgb,
            var(--surface) 72%,
            transparent
          );
        backdrop-filter: blur(10px);
      }

      .map-overlay span,
      .map-overlay strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .map-overlay span {
        color: var(--muted);
        font-size: 7px;
      }

      .map-overlay strong {
        font-size: 9px;
      }

      .map-overlay--top {
        left: 12px;
        top: 12px;
      }

      .map-overlay--bottom {
        left: 12px;
        bottom: 12px;
      }

      .map-center {
        position: absolute;
        left: 66%;
        top: 38%;
        width: 36px;
        height: 36px;
        transform: translate(-50%, -50%);
        border:
          1px dashed
          color-mix(
            in srgb,
            var(--green) 45%,
            transparent
          );
        border-radius: 50%;
      }

      .map-center span {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 5px;
        height: 5px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: var(--green);
      }

      .preflight-list {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .preflight-row {
        min-height: 70px;
        display: grid;
        grid-template-columns: 20px 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 10px 13px;
        border-bottom: 1px solid var(--line);
        cursor: pointer;
      }

      .preflight-row:last-child {
        border-bottom: 0;
      }

      .preflight-row input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .custom-check {
        width: 18px;
        height: 18px;
        display: grid;
        place-items: center;
        border: 1px solid var(--green);
        border-radius: 5px;
        color: var(--green);
        background:
          color-mix(
            in srgb,
            var(--green) 7%,
            transparent
          );
      }

      .preflight-row input:checked + .custom-check::after {
        content: "✓";
        font-size: 10px;
        font-weight: 900;
      }

      .preflight-copy {
        display: grid;
        gap: 4px;
      }

      .preflight-row strong {
        font-size: 9px;
      }

      .preflight-row small,
      .preflight-row b {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .preflight-row b {
        color: var(--green);
      }

      .mission-config-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
      }

      .config-card {
        min-height: 105px;
        display: grid;
        align-content: space-between;
        padding: 13px;
        border: 1px solid var(--line);
        border-radius: var(--radius-small);
        background: var(--surface);
      }

      .config-card span,
      .config-card strong,
      .config-card small {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .config-card span,
      .config-card small {
        color: var(--muted);
        font-size: 7px;
      }

      .config-card strong {
        font-size: 14px;
      }

      .config-card small {
        color: var(--muted-2);
      }

      .mission-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        margin-top: 12px;
      }

      /* ==========================================================
         DATA
      =========================================================== */
      .date-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .date-bar > div {
        display: grid;
        gap: 5px;
        text-align: center;
      }

      .date-bar strong {
        font-size: 11px;
      }

      .date-arrow {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 9px;
        color: var(--muted);
      }

      .daily-summary {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
        margin-top: 9px;
      }

      .daily-summary > div {
        min-height: 88px;
        display: grid;
        align-content: space-between;
        padding: 13px;
        border: 1px solid var(--line);
        border-radius: var(--radius-small);
        background: var(--surface);
      }

      .daily-summary span,
      .daily-summary strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .daily-summary span {
        color: var(--muted);
        font-size: 7px;
      }

      .daily-summary strong {
        font-size: 19px;
        letter-spacing: -0.04em;
      }

      .data-tabs,
      .more-switcher {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
        margin-top: 18px;
        padding: 4px;
        border: 1px solid var(--line);
        border-radius: 11px;
        background: var(--surface);
      }

      .data-tab,
      .more-tab {
        min-height: 36px;
        border-radius: 7px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .data-tab.is-active,
      .more-tab.is-active {
        color:
          color-mix(
            in srgb,
            var(--bg) 96%,
            black
          );
        background: var(--green);
      }

      .data-pane,
      .more-pane {
        display: none;
        margin-top: 12px;
      }

      .data-pane.is-active,
      .more-pane.is-active {
        display: block;
        animation: screenIn 0.24s ease both;
      }

      .timeline-head {
        display: grid;
        grid-template-columns: 1fr 1fr 1.15fr 0.7fr;
        gap: 10px;
        padding: 0 10px 8px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 6px;
        letter-spacing: 0.1em;
      }

      .timeline {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .capture-row {
        min-height: 72px;
        display: grid;
        grid-template-columns: 1fr 1fr 1.15fr 0.7fr;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border-bottom: 1px solid var(--line);
      }

      .capture-row:last-child {
        border-bottom: 0;
      }

      .capture-row__time,
      .capture-row__id,
      .capture-row__position,
      .capture-row__status {
        display: grid;
        gap: 4px;
        min-width: 0;
      }

      .capture-row strong,
      .capture-row small,
      .capture-row span {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .capture-row strong {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 8px;
      }

      .capture-row small,
      .capture-row span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--muted);
        font-size: 6px;
      }

      .capture-row__status span {
        justify-self: start;
        padding: 5px 6px;
        border:
          1px solid
          color-mix(
            in srgb,
            var(--green) 13%,
            transparent
          );
        border-radius: 5px;
        color: var(--green);
        background:
          color-mix(
            in srgb,
            var(--green) 4%,
            transparent
          );
      }

      .load-more {
        width: 100%;
        margin-top: 9px;
        min-height: 46px;
        border: 1px solid var(--line);
        border-radius: 10px;
        color: var(--muted);
        background: var(--surface);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .load-more span {
        margin-left: 7px;
        color: var(--green);
      }

      .validation-hero,
      .storage-hero,
      .calibration-head,
      .device-detail {
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background:
          linear-gradient(
            130deg,
            color-mix(
              in srgb,
              var(--green) 5%,
              transparent
            ),
            transparent 65%
          ),
          var(--surface);
      }

      .validation-hero,
      .storage-hero {
        display: flex;
        justify-content: space-between;
        gap: 15px;
      }

      .validation-hero > div,
      .storage-info {
        display: grid;
        gap: 6px;
      }

      .validation-hero h2,
      .storage-info h2,
      .calibration-head h2,
      .device-detail h2 {
        font-size: 16px;
        letter-spacing: -0.03em;
      }

      .validation-hero p,
      .storage-info p,
      .calibration-head p,
      .device-detail p {
        color: var(--muted);
        font-size: 9px;
        line-height: 1.55;
      }

      .comparison-table {
        overflow: hidden;
        margin-top: 9px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .comparison-row {
        min-height: 52px;
        display: grid;
        grid-template-columns: 1.35fr repeat(3, 1fr);
        align-items: center;
        gap: 10px;
        padding: 0 13px;
        border-bottom: 1px solid var(--line);
      }

      .comparison-row:last-child {
        border-bottom: 0;
      }

      .comparison-row--head {
        min-height: 39px;
        color: var(--muted);
        background:
          color-mix(
            in srgb,
            var(--surface) 98%,
            var(--text)
          );
      }

      .comparison-row span,
      .comparison-row strong,
      .comparison-row b {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .comparison-row strong {
        font-size: 8px;
      }

      .delta-good {
        color: var(--green);
      }

      .delta-warn {
        color: var(--amber);
      }

      .index-grid,
      .postgis-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
        margin-top: 9px;
      }

      .index-card,
      .postgis-card {
        min-height: 110px;
        display: grid;
        align-content: space-between;
        padding: 13px;
        border: 1px solid var(--line);
        border-radius: var(--radius-small);
        background: var(--surface);
      }

      .index-card span,
      .index-card small,
      .postgis-card span,
      .postgis-card small {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .index-card strong,
      .postgis-card strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 20px;
      }

      .index-card strong {
        color: var(--green);
      }

      .validation-note {
        display: grid;
        grid-template-columns: 23px 1fr;
        gap: 10px;
        margin-top: 9px;
        padding: 12px;
        border: 1px solid var(--line);
        border-radius: var(--radius-small);
      }

      .validation-note > span {
        width: 22px;
        height: 22px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 50%;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
      }

      .validation-note p {
        color: var(--muted);
        font-size: 8px;
        line-height: 1.55;
      }

      .storage-visual {
        display: grid;
        place-items: center;
      }

      .storage-ring {
        width: 90px;
        height: 90px;
        display: grid;
        place-items: center;
        border:
          8px solid
          color-mix(
            in srgb,
            var(--text) 6%,
            transparent
          );
        border-top-color: var(--green);
        border-right-color: var(--green);
        border-radius: 50%;
      }

      .storage-ring span {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 12px;
        font-weight: 900;
      }

      .storage-progress {
        margin-top: 8px;
      }

      .storage-meta {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .storage-meta strong {
        color: var(--green);
      }

      .data-schema {
        margin-top: 9px;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .data-schema__head,
      .schema-row {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 11px 13px;
        border-bottom: 1px solid var(--line);
      }

      .schema-row:last-child {
        border-bottom: 0;
      }

      .data-schema__head span,
      .schema-row span,
      .schema-row strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .data-schema__head span {
        color: var(--muted);
      }

      .schema-row span {
        color: var(--muted-2);
      }

      .schema-row strong {
        max-width: 65%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* ==========================================================
         MORE / DEVICE / SETTINGS
      =========================================================== */
      .more-switcher {
        margin-top: -3px;
        margin-bottom: 12px;
      }

      .calibration-head,
      .device-detail {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
      }

      .calibration-state {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        color: var(--green);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 900;
      }

      .calibration-state span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--green);
        box-shadow:
          0 0 10px
          color-mix(
            in srgb,
            var(--green) 70%,
            transparent
          );
      }

      .panel-grid {
        display: grid;
        gap: 9px;
        margin-top: 9px;
      }

      .reference-panel {
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .reference-panel__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .reference-panel__top > div {
        display: flex;
        align-items: center;
        gap: 9px;
      }

      .panel-number {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        border-radius: 7px;
        background: var(--surface-3);
        color: var(--green);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
      }

      .reference-panel strong {
        font-size: 10px;
      }

      .panel-state {
        color: var(--green);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .panel-surface {
        height: 74px;
        margin: 12px 0;
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .panel-surface--dark {
        background:
          linear-gradient(
            135deg,
            #1b1e1c,
            #292e2a
          );
      }

      .panel-surface--mid {
        background:
          linear-gradient(
            135deg,
            #666b64,
            #8a9188
          );
      }

      .panel-surface--light {
        background:
          linear-gradient(
            135deg,
            #c6c6bd,
            #ecebe0
          );
      }

      .reflectance-fields {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
      }

      .reflectance-fields label {
        display: grid;
        gap: 5px;
      }

      .reflectance-fields label > span {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .reflectance-fields input {
        width: 100%;
        min-height: 32px;
        padding: 0 6px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: var(--surface-2);
        color: var(--text);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
      }

      .panel-button {
        width: 100%;
        min-height: 37px;
        margin-top: 10px;
        border: 1px solid var(--line-strong);
        border-radius: 8px;
        color: var(--muted);
        background: var(--surface-2);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: 0.08em;
      }

      .panel-button.is-done {
        border-color:
          color-mix(
            in srgb,
            var(--green) 25%,
            transparent
          );
        color: var(--green);
        background:
          color-mix(
            in srgb,
            var(--green) 5%,
            transparent
          );
      }

      .spectrometer-card {
        padding: 15px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .spectrometer-card__top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
      }

      .spectrometer-card__top > div {
        display: grid;
        gap: 5px;
      }

      .spectrometer-card h3 {
        font-size: 13px;
      }

      .connected-tag {
        align-self: start;
      }

      .connected-tag i {
        width: 5px;
        height: 5px;
        display: inline-block;
        border-radius: 50%;
        background: var(--green);
      }

      .spectrometer-chart {
        position: relative;
        height: 130px;
        overflow: hidden;
        margin: 15px 0;
        border: 1px solid var(--line);
        border-radius: 8px;
        background:
          linear-gradient(
            color-mix(
              in srgb,
              var(--text) 4%,
              transparent
            )
            1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            color-mix(
              in srgb,
              var(--text) 4%,
              transparent
            )
            1px,
            transparent 1px
          );
        background-size: 25px 25px;
      }

      .chart-line {
        position: absolute;
        left: 0;
        width: 150%;
        height: 2px;
        border-radius: 999px;
        transform-origin: left center;
        background: var(--green);
        box-shadow:
          0 0 10px
          color-mix(
            in srgb,
            var(--green) 16%,
            transparent
          );
      }

      .chart-line--a {
        top: 64%;
        transform: rotate(-9deg);
      }

      .chart-line--b {
        top: 44%;
        opacity: 0.65;
        transform: rotate(7deg);
      }

      .chart-line--c {
        top: 70%;
        opacity: 0.35;
        transform: rotate(16deg);
      }

      .chart-marker {
        position: absolute;
        top: 12px;
        bottom: 12px;
        width: 1px;
        border-left:
          1px dashed
          color-mix(
            in srgb,
            var(--green) 22%,
            transparent
          );
      }

      .chart-marker--1 {
        left: 24%;
      }

      .chart-marker--2 {
        left: 52%;
      }

      .chart-marker--3 {
        left: 78%;
      }

      .spectrometer-values {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-bottom: 12px;
      }

      .spectrometer-values > div {
        display: grid;
        gap: 5px;
      }

      .spectrometer-values span,
      .spectrometer-values strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .spectrometer-values span {
        color: var(--muted);
      }

      .validation-flow {
        display: grid;
        gap: 0;
        align-items: center;
        overflow: auto hidden;
        padding-bottom: 3px;
      }

      .flow-node {
        min-width: 100%;
        display: grid;
        grid-template-columns: 28px 1fr;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface);
      }

      .flow-node > span {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        border-radius: 6px;
        background: var(--surface-3);
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .flow-node strong,
      .flow-node small {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .flow-node strong {
        font-size: 8px;
      }

      .flow-node small {
        color: var(--muted);
        font-size: 6px;
      }

      .flow-node.is-done > span {
        background:
          color-mix(
            in srgb,
            var(--green) 9%,
            transparent
          );
        color: var(--green);
      }

      .flow-line {
        width: 1px;
        height: 15px;
        margin-left: 24px;
        background: var(--line-strong);
      }

      .flow-line.is-done {
        background:
          color-mix(
            in srgb,
            var(--green) 35%,
            transparent
          );
      }

      .validation-disclaimer {
        margin-top: 10px;
        padding: 12px;
        border: 1px solid var(--line);
        border-radius: var(--radius-small);
        background:
          color-mix(
            in srgb,
            var(--surface) 98%,
            var(--text)
          );
      }

      .validation-disclaimer strong {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .validation-disclaimer p {
        margin-top: 5px;
        color: var(--muted);
        font-size: 8px;
        line-height: 1.55;
      }

      /* DEVICE DETAIL */
      .device-detail__hero {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 13px;
      }

      .device-orb {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border:
          1px solid
          color-mix(
            in srgb,
            var(--green) 20%,
            transparent
          );
        border-radius: 14px;
        background:
          color-mix(
            in srgb,
            var(--green) 6%,
            transparent
          );
      }

      .device-orb span {
        width: 19px;
        height: 19px;
        display: block;
        border: 1px solid var(--green);
        border-radius: 50%;
        box-shadow:
          0 0 20px
          color-mix(
            in srgb,
            var(--green) 17%,
            transparent
          );
      }

      .device-detail__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        margin-top: 9px;
      }

      .device-detail__grid > div {
        display: grid;
        gap: 5px;
        min-height: 68px;
        padding: 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background:
          color-mix(
            in srgb,
            var(--surface) 98%,
            var(--text)
          );
      }

      .device-detail__grid span,
      .device-detail__grid strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .device-detail__grid span {
        color: var(--muted);
      }

      .device-manage-button {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: var(--radius-small);
        background: var(--surface);
        text-align: left;
      }

      .device-manage-button > span:first-child {
        display: grid;
        gap: 4px;
      }

      .device-manage-button small,
      .device-manage-button strong,
      .device-manage-button > span:last-child {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .device-manage-button small {
        color: var(--muted);
        font-size: 7px;
      }

      .device-manage-button strong {
        font-size: 10px;
      }

      .device-manage-button > span:last-child {
        color: var(--green);
        font-size: 7px;
        font-weight: 800;
      }

      /* SETTINGS */
      .settings-list {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .settings-row {
        min-height: 69px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--line);
      }

      .settings-row:last-child {
        border-bottom: 0;
      }

      .settings-row > div {
        display: grid;
        gap: 4px;
      }

      .settings-row strong,
      .settings-row small {
        font-size: 8px;
      }

      .settings-row small {
        color: var(--muted);
      }

      .setting-value {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 900;
      }

      .setting-value--ok {
        color: var(--green);
      }

      .toggle {
        position: relative;
        width: 39px;
        height: 23px;
        flex-shrink: 0;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        background: var(--surface-3);
      }

      .toggle span {
        position: absolute;
        left: 3px;
        top: 3px;
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background: var(--muted);
        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }

      .toggle.is-on {
        border-color:
          color-mix(
            in srgb,
            var(--green) 25%,
            transparent
          );
        background:
          color-mix(
            in srgb,
            var(--green) 8%,
            transparent
          );
      }

      .toggle.is-on span {
        transform: translateX(16px);
        background: var(--green);
      }

      .policy-card,
      .about-card {
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .policy-card {
        display: grid;
        gap: 10px;
      }

      .policy-card > div {
        display: grid;
        gap: 5px;
      }

      .policy-card strong {
        font-size: 10px;
      }

      .policy-card p,
      .about-card p,
      .about-card span {
        color: var(--muted);
        font-size: 8px;
        line-height: 1.55;
      }

      .about-card {
        display: grid;
        gap: 5px;
      }

      .about-card strong {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 9px;
      }

      /* THEME */
      .theme-panel {
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .theme-panel__head {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        align-items: center;
      }

      .theme-panel__head > div {
        display: grid;
        gap: 5px;
      }

      .theme-panel__head strong,
      .theme-current {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
      }

      .theme-current {
        color: var(--green);
        font-weight: 900;
      }

      .theme-switch {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        margin-top: 13px;
      }

      .theme-option {
        position: relative;
        min-height: 92px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface-2);
        text-align: left;
        transition:
          border-color 0.18s ease,
          background 0.18s ease;
      }

      .theme-option.is-active {
        border-color:
          color-mix(
            in srgb,
            var(--green) 32%,
            transparent
          );
        background:
          color-mix(
            in srgb,
            var(--green) 6%,
            transparent
          );
      }

      .theme-option__visual {
        width: 48px;
        height: 58px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 4px;
        padding: 7px;
        border: 1px solid var(--line);
        border-radius: 7px;
      }

      .theme-option__visual i {
        display: block;
        border-radius: 3px;
      }

      .theme-option__visual--dark {
        background: #111512;
      }

      .theme-option__visual--dark i:nth-child(1) {
        background: #242a26;
      }

      .theme-option__visual--dark i:nth-child(2) {
        background: #20251f;
      }

      .theme-option__visual--dark i:nth-child(3) {
        background: #c6f56e;
      }

      .theme-option__visual--light {
        background: #eff1eb;
      }

      .theme-option__visual--light i:nth-child(1) {
        background: #d5d9d0;
      }

      .theme-option__visual--light i:nth-child(2) {
        background: #ffffff;
      }

      .theme-option__visual--light i:nth-child(3) {
        background: #587f1e;
      }

      .theme-option__copy {
        display: grid;
        gap: 5px;
      }

      .theme-option__copy strong,
      .theme-option__copy small {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .theme-option__copy strong {
        font-size: 9px;
      }

      .theme-option__copy small {
        color: var(--muted);
        font-size: 6px;
      }

      .theme-check {
        width: 19px;
        height: 19px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 50%;
        color: transparent;
        font-size: 8px;
      }

      .theme-option.is-active .theme-check {
        border-color: var(--green);
        color:
          color-mix(
            in srgb,
            var(--bg) 96%,
            black
          );
        background: var(--green);
      }

      /* ==========================================================
         BOTTOM NAV
      =========================================================== */
      .bottom-nav {
        position: fixed;
        left: 50%;
        bottom: 0;
        z-index: 200;
        width: min(740px, calc(100% - 18px));
        height: var(--nav-h);
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        align-items: stretch;
        transform: translateX(-50%);
        margin-bottom: 9px;
        overflow: hidden;
        border: 1px solid var(--line-strong);
        border-radius: 17px;
        background:
          color-mix(
            in srgb,
            var(--surface) 93%,
            transparent
          );
        backdrop-filter: blur(20px);
        box-shadow: var(--shadow);
      }

      .bottom-nav__item {
        position: relative;
        display: grid;
        place-items: center;
        align-content: center;
        gap: 5px;
        color: var(--muted-2);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: 0.06em;
      }

      .bottom-nav__item.is-active {
        color: var(--green);
      }

      .bottom-nav__item.is-active::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 0;
        width: 24px;
        height: 2px;
        transform: translateX(-50%);
        background: var(--green);
        box-shadow:
          0 0 12px
          color-mix(
            in srgb,
            var(--green) 50%,
            transparent
          );
      }

      .bottom-nav__icon {
        font-size: 15px;
        line-height: 1;
      }

      .bottom-nav__icon--capture {
        width: 29px;
        height: 29px;
        display: grid;
        place-items: center;
        border: 1px solid currentColor;
        border-radius: 50%;
        font-size: 16px;
      }

      /* ==========================================================
         DEVICE MODAL
      =========================================================== */
      .device-modal {
        position: fixed;
        inset: 0;
        z-index: 500;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        pointer-events: none;
        visibility: hidden;
      }

      .device-modal.is-open {
        pointer-events: auto;
        visibility: visible;
      }

      .device-modal__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.58);
        opacity: 0;
        transition: opacity 0.22s ease;
      }

      .device-modal.is-open
        .device-modal__backdrop {
        opacity: 1;
      }

      .device-sheet {
        position: relative;
        width: min(680px, 100%);
        max-height: min(86vh, 760px);
        overflow: auto;
        padding: 9px 14px
          max(14px, env(safe-area-inset-bottom))
          16px;
        border:
          1px solid
          var(--line-strong);
        border-bottom: 0;
        border-radius: 20px 20px 0 0;
        background: var(--surface);
        box-shadow:
          0 -20px 60px rgba(0, 0, 0, 0.35);
        transform: translateY(105%);
        transition: transform 0.26s cubic-bezier(
          0.22,
          1,
          0.36,
          1
        );
      }

      .device-modal.is-open
        .device-sheet {
        transform: translateY(0);
      }

      .device-sheet__grab {
        width: 36px;
        height: 3px;
        margin: 0 auto 16px;
        border-radius: 999px;
        background: var(--line-strong);
      }

      .device-sheet__head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
      }

      .device-sheet__head > div {
        display: grid;
        gap: 5px;
      }

      .device-sheet__head h2 {
        margin-top: 2px;
        font-size: 24px;
        letter-spacing: -0.035em;
      }

      .device-sheet__head p {
        color: var(--muted);
        font-size: 9px;
      }

      .device-sheet__close {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 9px;
        color: var(--muted);
        font-size: 18px;
      }

      .device-scanbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 18px;
        padding: 9px 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface-2);
      }

      .device-scanbar > div {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .device-scanbar__dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--green);
        box-shadow:
          0 0 9px
          color-mix(
            in srgb,
            var(--green) 75%,
            transparent
          );
      }

      .device-scanbar span,
      .device-scanbar button {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
      }

      .device-scanbar span {
        color: var(--muted);
      }

      .device-scanbar button {
        color: var(--green);
        font-weight: 900;
      }

      .device-list {
        display: grid;
        gap: 8px;
        margin-top: 10px;
      }

      .device-option {
        position: relative;
        display: grid;
        grid-template-columns: 8px 1fr auto;
        align-items: center;
        gap: 10px;
        min-height: 91px;
        padding: 12px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
        text-align: left;
        transition:
          border-color 0.18s ease,
          background 0.18s ease,
          transform 0.18s ease;
      }

      .device-option:hover {
        transform: translateY(-1px);
        border-color: var(--line-strong);
      }

      .device-option.is-selected {
        border-color:
          color-mix(
            in srgb,
            var(--green) 32%,
            transparent
          );
        background:
          color-mix(
            in srgb,
            var(--green) 5.5%,
            transparent
          );
      }

      .device-option__indicator {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--muted-2);
      }

      .device-option.is-selected
        .device-option__indicator {
        background: var(--green);
        box-shadow:
          0 0 10px
          color-mix(
            in srgb,
            var(--green) 70%,
            transparent
          );
      }

      .device-option__main {
        display: grid;
        gap: 4px;
        min-width: 0;
      }

      .device-option__main strong,
      .device-option__main small,
      .device-option__main em {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .device-option__main strong {
        font-size: 9px;
      }

      .device-option__main small {
        color: var(--muted);
        font-size: 7px;
      }

      .device-option__main em {
        color: var(--muted-2);
        font-size: 6px;
        font-style: normal;
        letter-spacing: 0.04em;
      }

      .device-option__meta {
        display: grid;
        justify-items: end;
        gap: 5px;
      }

      .device-option__meta b,
      .device-option__meta span {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      .device-option__meta b {
        color: var(--green);
        font-size: 6px;
      }

      .device-option__meta span {
        color: var(--muted);
        font-size: 7px;
      }

      .device-option__meta--idle b {
        color: var(--amber);
      }

      .device-option__meta--offline b {
        color: var(--red);
      }

      .device-sheet__footer {
        display: grid;
        gap: 10px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--line);
      }

      .device-sheet__footer > span {
        color: var(--muted);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 6px;
        text-align: center;
        letter-spacing: 0.08em;
      }

      .device-connect-button {
        width: 100%;
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 14px;
        border: 1px solid var(--green);
        border-radius: 9px;
        background: var(--green);
        color:
          color-mix(
            in srgb,
            var(--bg) 95%,
            black
          );
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 0.1em;
      }

      .device-connect-button span {
        font-size: 14px;
      }

      /* ==========================================================
         TOAST
      =========================================================== */
      .toast {
        position: fixed;
        left: 50%;
        bottom: calc(
          var(--nav-h) + 24px
        );
        z-index: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        max-width: calc(100% - 28px);
        padding: 9px 12px;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        background:
          color-mix(
            in srgb,
            var(--surface) 95%,
            transparent
          );
        box-shadow: var(--shadow);
        transform:
          translate(-50%, 12px);
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.22s ease,
          transform 0.22s ease;
      }

      .toast.is-visible {
        opacity: 1;
        transform:
          translate(-50%, 0);
      }

      .toast__dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--green);
        box-shadow:
          0 0 10px
          color-mix(
            in srgb,
            var(--green) 70%,
            transparent
          );
      }

      .toast #toastText {
        color: var(--text);
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 7px;
        font-weight: 800;
      }

      /* ==========================================================
         RESPONSIVE
      =========================================================== */
      @media (min-width: 700px) {
        .main {
          padding: 38px 24px 50px;
        }

        .telemetry-grid {
          grid-template-columns: repeat(4, 1fr);
        }

        .camera-summary {
          grid-template-columns: 1.25fr 0.75fr;
        }

        .camera-preview--small {
          min-height: 290px;
        }

        .quick-grid {
          grid-template-columns: repeat(4, 1fr);
        }

        .today-card {
          padding: 22px;
        }

        .panel-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .validation-flow {
          grid-template-columns:
            auto 30px
            auto 30px
            auto 30px
            auto;
          overflow: visible;
        }

        .flow-node {
          min-width: 0;
        }

        .flow-line {
          width: 100%;
          height: 1px;
          margin: 0;
        }

        .device-sheet {
          margin-bottom: 14px;
          border-bottom: 1px solid var(--line-strong);
          border-radius: 20px;
        }
      }

      @media (min-width: 1000px) {
        :root {
          --topbar-h: 76px;
        }

        .topbar {
          padding-inline: 26px;
        }

        .main {
          padding-inline: 30px;
        }

        .screen-head {
          margin-bottom: 32px;
        }

        .camera-preview--large {
          min-height: 610px;
        }

        .capture-actions {
          padding: 24px;
        }

        .metadata-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .mission-config-grid {
          grid-template-columns: repeat(4, 1fr);
        }

        .daily-summary {
          grid-template-columns: repeat(4, 1fr);
        }

        .index-grid,
        .postgis-grid {
          grid-template-columns: repeat(4, 1fr);
        }

        .device-detail__grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .bottom-nav {
          bottom: 14px;
          height: 68px;
        }

        .toast {
          bottom: 96px;
        }
      }

      @media (max-width: 520px) {
        .device-trigger__copy {
          display: none;
        }

        .device-trigger {
          width: 38px;
          justify-content: center;
          padding: 0;
        }

        .device-trigger__chevron {
          display: none;
        }
      }

      @media (max-width: 410px) {
        .topbar__center {
          display: none;
        }

        .screen-head {
          align-items: flex-start;
        }

        .screen-head__meta {
          display: none;
        }

        .mission-hero__stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .capture-actions {
          gap: 7px;
        }

        .shutter-button {
          width: 82px;
          height: 82px;
        }

        .capture-secondary {
          padding-inline: 5px;
        }

        .band-overview__row {
          grid-template-columns: 78px 45px 1fr 25px;
          gap: 7px;
        }

        .comparison-row {
          grid-template-columns: 1.2fr repeat(3, 1fr);
          gap: 5px;
        }

        .theme-switch {
          grid-template-columns: 1fr;
        }

        .device-detail__hero {
          grid-template-columns: auto 1fr;
        }

        .device-detail__hero
          .status-pill {
          grid-column: 2;
          justify-self: start;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>